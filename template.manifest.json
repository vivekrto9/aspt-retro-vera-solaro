{
  "templateKey": "astropages-base-template",
  "displayName": "AstroPages Base Template",
  "repo": {
    "url": "https://github.com/vivekrto9/base-template.git",
    "commitSha": "RESOLVED_AT_TEMPLATE_REGISTRATION"
  },
  "stage": "starter-template",
  "runtime": {
    "type": "official-emdash-astro-cloudflare",
    "scaffold": {
      "package": "create-emdash",
      "version": "0.14.0",
      "template": "cloudflare:starter"
    },
    "requiredFiles": [
      "astro.config.mjs",
      "src/live.config.ts",
      "src/worker.ts",
      "wrangler.jsonc"
    ],
    "adminPath": "/_emdash/admin",
    "apiPrefix": "/_emdash/api"
  },
  "leads": {
    "required": true,
    "path": "astropages/leads.manifest.json"
  },
  "cloudflare": {
    "runtimeContractStatus": "defined",
    "wranglerConfig": "wrangler.jsonc",
    "environments": [
      {
        "name": "preview",
        "workerName": "astropages-base-template-preview",
        "d1DatabaseName": "astropages-base-template-preview-site",
        "r2BucketName": "astropages-base-template-preview-media",
        "kvNamespaceName": "astropages-base-template-preview-session",
        "siteUrlVariable": "PREVIEW_SITE_URL",
        "d1DatabaseIdVariable": "PREVIEW_SITE_D1_DATABASE_ID",
        "sessionKvNamespaceIdVariable": "PREVIEW_SITE_SESSION_KV_NAMESPACE_ID"
      },
      {
        "name": "production",
        "workerName": "astropages-base-template-production",
        "d1DatabaseName": "astropages-base-template-production-site",
        "r2BucketName": "astropages-base-template-production-media",
        "kvNamespaceName": "astropages-base-template-production-session",
        "siteUrlVariable": "PRODUCTION_SITE_URL",
        "d1DatabaseIdVariable": "PRODUCTION_SITE_D1_DATABASE_ID",
        "sessionKvNamespaceIdVariable": "PRODUCTION_SITE_SESSION_KV_NAMESPACE_ID"
      }
    ],
    "bindings": [
      {
        "name": "DB",
        "type": "d1",
        "purpose": "EmDash and generated-site runtime data"
      },
      {
        "name": "MEDIA",
        "type": "r2",
        "purpose": "EmDash media storage"
      },
      {
        "name": "SESSION",
        "type": "kv",
        "purpose": "Astro and EmDash session storage"
      },
      {
        "name": "LOADER",
        "type": "worker_loader",
        "purpose": "EmDash plugin sandboxing"
      },
      {
        "name": "IMAGES",
        "type": "images",
        "purpose": "Astro Cloudflare image transformation"
      }
    ]
  },
  "secrets": {
    "requiredNow": [
      "EMDASH_ENCRYPTION_KEY",
      "BUILDER_MCP_TOKEN",
      "BUILDER_MCP_PROVISION_SECRET"
    ],
    "requiredForTemplateDeployment": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_DEV_WORKERS_SUBDOMAIN",
      "EMDASH_ENCRYPTION_KEY",
      "BUILDER_MCP_TOKEN",
      "BUILDER_MCP_PROVISION_SECRET"
    ],
    "requiredForGeneratedSiteDeployment": [
      "CLOUDFLARE_API_TOKEN",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_DEV_WORKERS_SUBDOMAIN",
      "EMDASH_ENCRYPTION_KEY",
      "ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN",
      "ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL",
      "ASTROPAGES_SSO_PUBLIC_JWK"
    ],
    "deploymentVariables": [
      "GH_REPOSITORY_VARIABLES_TOKEN",
      "CLOUDFLARE_SECRETS_STORE_ID",
      "PREVIEW_SITE_D1_DATABASE_ID",
      "PREVIEW_SITE_SESSION_KV_NAMESPACE_ID",
      "PREVIEW_SITE_URL",
      "PRODUCTION_SITE_D1_DATABASE_ID",
      "PRODUCTION_SITE_SESSION_KV_NAMESPACE_ID",
      "PRODUCTION_SITE_URL"
    ],
    "deploymentMapping": {
      "workerSecretsFile": "astropages-base-template-worker-secrets.json",
      "workerSecrets": [
        "EMDASH_ENCRYPTION_KEY",
        "BUILDER_MCP_TOKEN",
        "BUILDER_MCP_PROVISION_SECRET"
      ],
      "generatedSiteWorkerSecrets": [
        "EMDASH_ENCRYPTION_KEY",
        "ASTROPAGES_CONTROL_PLANE_CALLBACK_TOKEN"
      ],
      "generatedSiteRuntimeVars": [
        "ASTROPAGES_PROJECT_ID",
        "ASTROPAGES_SITE_ENVIRONMENT",
        "ASTROPAGES_SSO_PUBLIC_JWK"
      ],
      "secretStoreBundleBinding": "ASTROPAGES_INTEGRATION_SECRETS_JSON",
      "platformGooglePlacesBinding": "ASTROPAGES_PLATFORM_GOOGLE_PLACES_API_KEY"
    },
    "valuesAllowedInSource": false,
    "generatedSiteRuntimeConfig": [
      "SES_SENDER_EMAIL",
      "SES_SENDER_NAME",
      "AWS_REGION",
      "POSTHOG_PROJECT_API_KEY",
      "POSTHOG_HOST",
      "POSTHOG_PROJECT_ID"
    ],
    "providerCredentials": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "POSTHOG_PROJECT_API_KEY",
      "POSTHOG_HOST",
      "POSTHOG_PROJECT_ID",
      "POSTHOG_PERSONAL_API_KEY"
    ]
  },
  "localization": {
    "strategy": "query-param",
    "requiredDefaultLocale": "en",
    "defaultLocale": "en",
    "activeLocales": [
      "en"
    ],
    "availableLocaleCatalog": [
      "en",
      "hi",
      "ta",
      "te",
      "bn",
      "mr"
    ],
    "maxActiveLocales": 8,
    "rtlSupported": false,
    "editableContentSource": "src/data/public-copy.ts",
    "publicEditableCollection": "multiple",
    "publicEditableEntries": [
      "site_chrome/main",
      "site_pages/home",
      "site_pages/not_found_page"
    ],
    "disabledLocalePolicy": "available locales remain inactive until AstroPages enables and verifies translated copy"
  },
  "workflows": {
    "template": {
      "provider": "woodpecker",
      "configurationSource": "signed-control-plane-extension",
      "entrypoint": "pnpm run astropages:pipeline",
      "purposes": {
        "ci": "template_ci",
        "preview": "template_preview",
        "production": "template_production"
      },
      "githubSafetyCi": ".github/workflows/ci.yml",
      "catalogScreenshots": "admin-managed"
    },
    "generatedSite": {
      "previewSeed": ".astropages/generated-site-workflows/deploy-preview.yml",
      "previewInstalledPath": ".github/workflows/deploy-preview.yml",
      "previewTrigger": "control-plane-workflow-dispatch",
      "previewCallback": {
        "statusRoute": "/callback/preview-deployments/:previewDeploymentId/status",
        "auth": "service-bearer",
        "urlSource": "ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL"
      },
      "productionSeed": ".astropages/generated-site-workflows/deploy-production.yml",
      "productionInstalledPath": ".github/workflows/deploy-production.yml",
      "productionTrigger": "control-plane-workflow-dispatch",
      "productionCallback": {
        "statusRoute": "/callback/production-deployments/:productionDeploymentId/status",
        "auth": "service-bearer",
        "urlSource": "ASTROPAGES_CONTROL_PLANE_CALLBACK_BASE_URL"
      }
    }
  },
  "routes": {
    "admin": "/_emdash/admin",
    "emdashApiPrefix": "/_emdash/api",
    "visitorRoutes": [
      {
        "method": "GET",
        "path": "/",
        "status": "implemented",
        "capabilityKey": "content-seo-localization"
      },
      {
        "method": "GET",
        "path": "/login",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      },
      {
        "method": "GET",
        "path": "/signup",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      },
      {
        "method": "GET",
        "path": "/forgot-password",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      },
      {
        "method": "GET",
        "path": "/reset-password",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      }
    ],
    "generatedSiteApis": [
      {
        "method": "GET",
        "path": "/api/astropages/generated-site/health",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "GET",
        "path": "/api/astropages/generated-site/edit-readiness",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/emdash/bootstrap",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "GET",
        "path": "/api/astropages/generated-site/content-release/status",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/content-release/export",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/content-release/import",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "GET",
        "path": "/api/astropages/generated-site/editor/content-diff",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/editor/content-field",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/editor/provision-mcp-token",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/customer-auth/login",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/customer-auth/signup",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/customer-auth/request-password-reset",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/customer-auth/reset-password",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/customer-auth/logout",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      },
      {
        "method": "GET",
        "path": "/api/astropages/generated-site/customer-auth/me",
        "status": "implemented",
        "capabilityKey": "customer-auth"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/runtime-config/sync",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "GET",
        "path": "/api/astropages/generated-site/sso/exchange",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/sso/logout",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "POST",
        "path": "/api/astropages/provision/emdash-mcp-token",
