        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "PATCH",
        "path": "/api/astropages/generated-site/assets/[assetId]",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "DELETE",
        "path": "/api/astropages/generated-site/assets/[assetId]",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/assets/[assetId]/restore",
        "status": "implemented",
        "capabilityKey": "generated-site-operations"
      },
      {
        "method": "GET/POST",
        "path": "/api/astropages/generated-site/email-templates",
        "status": "implemented",
        "capabilityKey": "transactional-notifications",
        "capabilityFacet": "email-templates"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/email-templates/render",
        "status": "implemented",
        "capabilityKey": "transactional-notifications",
        "capabilityFacet": "email-templates"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/email-templates/test-send",
        "status": "implemented",
        "capabilityKey": "transactional-notifications",
        "capabilityFacet": "email-templates"
      },
      {
        "method": "POST",
        "path": "/api/astropages/generated-site/email-templates/publish",
