  },
  "supportedCapabilities": [
    "capability-content-seo-localization@0.3.0",
    "capability-generated-site-operations@0.3.0",
    "capability-customer-auth@0.1.0",
    "capability-transactional-notifications@0.3.0"
  ],
  "assets": {
    "contractVersion": 1,
    "manifestPath": "astropages/assets.manifest.json",
    "seedRoot": "astropages/assets"
  },
  "communications": {
    "contractVersion": "transactional-email.v1",
    "manifestPath": "astropages/email-templates.manifest.json",
    "managementMode": "project-d1-via-emdash-mcp"
  },
  "contracts": {
    "sales": {
      "required": true,
      "path": "astropages/sales.manifest.json"
    },
    "usersData": {
      "required": true,
      "path": "astropages/users-data.manifest.json"
    },
    "secrets": {
      "required": true,
      "path": "astropages/secrets.manifest.json"
    }
  },
  "runtimePersistence": {
    "status": "generated-site-runtime-managed",
    "binding": "DB",
    "canonicalSchema": "database/d1/001_initial_site_schema.sql",
    "wranglerMigration": "migrations/0000_emdash_schema_bootstrap.sql",
    "verificationQuery": "database/d1/verify_runtime_tables.sql",
    "tables": [
      "ap_runtime_config",
      "ap_business_settings",
      "ap_asset_records",
      "ap_asset_revisions",
      "ap_asset_aliases",
      "ap_asset_events",
      "ap_asset_release_state",
      "ap_admin_sessions",
      "ap_admin_sso_exchanges",
      "ap_content_revision_log",
      "ap_content_environment_state",
      "ap_emdash_bootstrap_state",
      "ap_customer_accounts",
      "ap_customer_sessions",
      "ap_customer_password_resets",
      "ap_business_events",
      "ap_leads",
      "ap_email_templates",
      "ap_email_events",
      "ap_email_variable_mappings"
    ]
  }
}
