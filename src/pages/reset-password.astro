---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

const seoContent = {
  seo_title: "Reset Password",
  seo_description: "Choose a new account password.",
  seo_canonical_path: "/reset-password",
  seo_robots: "noindex,follow",
  og_title: "Reset Password",
  og_description: "Choose a new account password.",
  twitter_title: "Reset Password",
  twitter_description: "Choose a new account password.",
};
---

<BaseLayout seo={seoContent} bodyClass="auth-body">
  <main class="auth-page" aria-labelledby="reset-password-title">
    <section class="auth-copy">
      <a class="brand" href="/">Base Template</a>
      <p class="eyebrow">New Password</p>
      <h1 id="reset-password-title">Choose new password</h1>
      <p class="lead">Reset links expire after 1 hour.</p>
    </section>

    <section class="auth-panel" aria-label="Reset password form">
      <h2>Reset password</h2>
      <form class="auth-form" data-password-reset-form>
        <label>
          New password
          <input type="password" name="password" autocomplete="new-password" required minlength="8" />
        </label>
        <label>
          Confirm password
          <input type="password" name="confirmPassword" autocomplete="new-password" required minlength="8" />
        </label>
        <button type="submit">Update password</button>
        <p class="auth-form__status" data-auth-status></p>
      </form>
    </section>
  </main>

  <script>
    document.querySelector("[data-password-reset-form]")?.addEventListener("submit", (event) => {
      event.preventDefault();
      const token = new URL(window.location.href).searchParams.get("token") || "";
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      const status = document.querySelector("[data-auth-status]");
      const formData = new FormData(form);
      const password = String(formData.get("password") || "");
      const confirmPassword = String(formData.get("confirmPassword") || "");
      if (password !== confirmPassword) {
        if (status instanceof HTMLElement) status.textContent = "Passwords do not match.";
        return;
      }
      if (status instanceof HTMLElement) status.textContent = "Updating password...";
      fetch("/api/astropages/generated-site/customer-auth/reset-password", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ token, password }),
      })
        .then(async (response) => {
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(payload.message || "Password reset failed.");
          if (status instanceof HTMLElement) status.textContent = payload.message || "Password updated.";
          window.setTimeout(() => window.location.assign("/login"), 700);
        })
        .catch((error) => {
          if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : "Password reset failed.";
        });
    });
  </script>
</BaseLayout>
