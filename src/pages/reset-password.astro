---
import {
  getSafePublicNextPath,
  loadPublicPageContent,
} from "../builder/public-page.ts";
import VeraFrame from "../components/vera/VeraFrame.astro";

export const prerender = false;

const page = await loadPublicPageContent(Astro, "reset_password");
const { builderEdit } = page;
const safeNext = getSafePublicNextPath(Astro.url);
const loginHref = `/login?next=${encodeURIComponent(safeNext)}`;
const forgotHref = `/forgot-password?next=${encodeURIComponent(safeNext)}`;
const content: Record<string, string> = {
  ...page.content,
  seo_title: page.content.reset_seo_title,
  seo_description: page.content.reset_seo_description,
  seo_canonical_path: page.content.reset_seo_canonical_path,
  seo_robots: page.content.auth_seo_robots,
  og_title: page.content.reset_seo_title,
  og_description: page.content.reset_seo_description,
  og_image: page.content.auth_social_image,
  og_image_alt: page.content.auth_social_image_alt,
  twitter_card: page.content.auth_twitter_card,
  twitter_title: page.content.reset_seo_title,
  twitter_description: page.content.reset_seo_description,
  twitter_image: page.content.auth_social_image,
};
---

<VeraFrame {...page} content={content} currentPath="/account">
  <section class="vera-page-hero vera-page-hero--split">
    <div>
      <div class="vera-placeholder-page__symbol" aria-hidden="true" {...builderEdit("auth_symbol")}>
        {content.auth_symbol}
      </div>
      <p class="vera-eyebrow" style="margin-top: 34px" {...builderEdit("auth_eyebrow")}>
        {content.auth_eyebrow}
      </p>
      <h1 id="reset-password-title" class="vera-display" {...builderEdit("reset_title")}>
        {content.reset_title}
      </h1>
      <p class="vera-lede" {...builderEdit("reset_intro")}>{content.reset_intro}</p>
    </div>

    <form
      class="vera-form-card"
      data-password-reset-form
      data-login-path={loginHref}
      aria-labelledby="reset-form-title"
    >
      <fieldset>
        <legend
          id="reset-form-title"
          style="font-family: var(--vera-font-display); font-size: 30px; color: var(--vera-aubergine); letter-spacing: 0; text-transform: none"
          {...builderEdit("reset_form_title")}
        >
          {content.reset_form_title}
        </legend>
        <label class="vera-field">
          <span class="vera-label" {...builderEdit("reset_new_password_label")}>
            {content.reset_new_password_label}
          </span>
          <input
            class="vera-input"
            type="password"
            name="password"
            autocomplete="new-password"
            required
            minlength="8"
            aria-describedby="reset-password-hint"
          />
          <span id="reset-password-hint" class="vera-form-note" {...builderEdit("password_hint")}>
            {content.password_hint}
          </span>
        </label>
        <label class="vera-field">
          <span class="vera-label" {...builderEdit("reset_confirm_password_label")}>
            {content.reset_confirm_password_label}
          </span>
          <input
            class="vera-input"
            type="password"
            name="confirmPassword"
            autocomplete="new-password"
            required
            minlength="8"
          />
        </label>
        <button
          class="vera-button vera-button--burnt vera-button--shadow"
          type="submit"
          {...builderEdit("reset_submit_cta")}
        >
          {content.reset_submit_cta}
        </button>
        <div aria-live="polite" aria-atomic="true">
          <p class="vera-form-note" data-auth-status="mismatch" hidden {...builderEdit("reset_mismatch_status")}>
            {content.reset_mismatch_status}
          </p>
          <p class="vera-form-note" data-auth-status="submitting" hidden {...builderEdit("reset_submitting_status")}>
            {content.reset_submitting_status}
          </p>
          <p class="vera-form-note" data-auth-status="success" hidden {...builderEdit("reset_success_status")}>
            {content.reset_success_status}
          </p>
          <p class="vera-form-note" data-auth-status="error" hidden {...builderEdit("reset_error_status")}>
            {content.reset_error_status}
          </p>
          <p class="vera-form-note" data-auth-status="invalid" hidden {...builderEdit("reset_invalid_token_status")}>
            {content.reset_invalid_token_status}
          </p>
          <p class="vera-form-note" data-reset-request hidden>
            <a href={forgotHref} style="color: var(--vera-burnt)" {...builderEdit("reset_request_cta")}>
              {content.reset_request_cta}
            </a>
          </p>
        </div>
      </fieldset>
    </form>
  </section>
</VeraFrame>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-password-reset-form]");
  const submit = form?.querySelector<HTMLButtonElement>("button[type='submit']");
  const statuses = [...document.querySelectorAll<HTMLElement>("[data-auth-status]")];
  const requestRow = document.querySelector<HTMLElement>("[data-reset-request]");
  const token = new URL(window.location.href).searchParams.get("token") || "";
  if (token) {
    const cleanUrl = new URL(window.location.href);
    cleanUrl.searchParams.delete("token");
    window.history.replaceState(window.history.state, "", `${cleanUrl.pathname}${cleanUrl.search}${cleanUrl.hash}`);
  }
  const showStatus = (state: string) => {
    statuses.forEach((status) => {
      status.hidden = status.dataset.authStatus !== state;
    });
    if (requestRow) requestRow.hidden = state !== "invalid" && state !== "error";
  };

  if (!token) {
    showStatus("invalid");
    if (submit) submit.disabled = true;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!token) {
      showStatus("invalid");
      return;
    }

    const formData = new FormData(form);
    const password = String(formData.get("password") || "");
    const confirmPassword = String(formData.get("confirmPassword") || "");
    if (password !== confirmPassword) {
      showStatus("mismatch");
      return;
    }

    showStatus("submitting");
    if (submit) submit.disabled = true;
    try {
      const response = await fetch("/api/astropages/generated-site/customer-auth/reset-password", {
        method: "POST",
        credentials: "same-origin",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ token, password }),
      });
      const payload = await response.json().catch(() => null) as { status?: string } | null;
      if (!response.ok || payload?.status !== "ready") throw new Error("reset-password");
      showStatus("success");
      window.setTimeout(() => window.location.assign(form.dataset.loginPath || "/login"), 700);
    } catch {
      showStatus("error");
      if (submit) submit.disabled = false;
    }
  });
</script>
