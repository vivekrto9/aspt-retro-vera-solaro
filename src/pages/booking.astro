</VeraFrame>

<script>
  import { loadStripe, type Stripe, type StripeCardElement } from "@stripe/stripe-js";

  type UnknownRecord = Record<string, unknown>;
  type ApiEnvelope = {
    status?: string;
    state?: string;
    data?: UnknownRecord;
  };

  class RequestFailure extends Error {
    status: number;
    state: string;

    constructor(status: number, state = "error") {
      super(state);
      this.status = status;
      this.state = state;
    }
  }

  const asRecord = (value: unknown): UnknownRecord =>
    value && typeof value === "object" && !Array.isArray(value) ? value as UnknownRecord : {};
  const asRecords = (value: unknown) => Array.isArray(value) ? value.map(asRecord) : [];
  const asText = (value: unknown) => typeof value === "string" ? value : "";
  const asNumber = (value: unknown) => Number.isFinite(Number(value)) ? Number(value) : 0;
  const apiBase = "/api/astropages/generated-site/vera";

  const requestJson = async (path: string, init: RequestInit = {}) => {
    const response = await fetch(path, {
      credentials: "same-origin",
      ...init,
      headers: {
        accept: "application/json",
        ...(init.body ? { "content-type": "application/json" } : {}),
        ...init.headers,
      },
    });
    const envelope = await response.json().catch(() => ({})) as ApiEnvelope;
    if (!response.ok || envelope.status !== "ready") {
      throw new RequestFailure(response.status, envelope.state || envelope.status || "error");
    }
    return asRecord(envelope.data);
  };

  const bookingForm = document.querySelector<HTMLFormElement>("[data-vera-booking]");
  const bookingSteps = Array.from(document.querySelectorAll<HTMLElement>("[data-booking-step]"));
  const bookingProgress = Array.from(document.querySelectorAll<HTMLElement>("[data-booking-progress]"));
  const bookingConfirmed = document.querySelector<HTMLElement>("[data-booking-confirmed]");
  const bookingHold = document.querySelector<HTMLElement>("[data-booking-hold]");
  const processingState = document.querySelector<HTMLElement>("[data-booking-state='processing']");
  const waitlistState = document.querySelector<HTMLElement>("[data-booking-state='waitlist']");
  const expiredState = document.querySelector<HTMLElement>("[data-booking-state='expired']");
  const declinedState = document.querySelector<HTMLElement>("[data-booking-state='declined']");
  const takenState = document.querySelector<HTMLElement>("[data-booking-state='slot-taken']");
  const slotMount = document.querySelector<HTMLElement>("[data-calendly-slot-mount]");
  const slotStatus = document.querySelector<HTMLElement>("[data-calendly-status]");
  const calendarMonthGrid = document.querySelector<HTMLElement>("[data-calendly-month-grid]");
  const calendarMonthLabel = document.querySelector<HTMLElement>("[data-calendly-month-label]");
  const calendarPrevMonth = document.querySelector<HTMLButtonElement>("[data-calendly-prev-month]");
  const calendarNextMonth = document.querySelector<HTMLButtonElement>("[data-calendly-next-month]");
  const calendarDayHours = document.querySelector<HTMLElement>("[data-calendly-day-hours]");
  const calendarDayLabel = document.querySelector<HTMLElement>("[data-calendly-day-label]");
  const calendarDayCount = document.querySelector<HTMLElement>("[data-calendly-day-count]");
  const calendarPrompt = document.querySelector<HTMLElement>("[data-calendly-prompt]");
  const calendarCopy = {
    slot: calendarMonthGrid?.dataset.slotSingular || "",
    slots: calendarMonthGrid?.dataset.slotPlural || "",
    hour: calendarMonthGrid?.dataset.hourSingular || "",
    hours: calendarMonthGrid?.dataset.hourPlural || "",
    time: calendarMonthGrid?.dataset.timeSuffix || "",
    noSittings: calendarMonthGrid?.dataset.noSittings || "",
  };
  const liveSlots = document.querySelector<HTMLElement>("[data-calendly-live-slots]");
  const waitlistOpenButtons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-booking-open-waitlist]"));
  const continueToDetails = document.querySelector<HTMLButtonElement>("[data-booking-next='2']");
  const continueToPayment = document.querySelector<HTMLButtonElement>("[data-booking-next='3']");
  const stripeMount = document.querySelector<HTMLElement>("[data-stripe-elements-mount]");
  const stripeFallback = document.querySelector<HTMLElement>("[data-stripe-fallback]");
  const submitButton = bookingForm?.querySelector<HTMLButtonElement>("button[type='submit']") ?? null;
  const submitCtaTemplate = submitButton?.textContent?.trim() || "";
  const depositBodyTemplate = document.querySelector<HTMLElement>("[data-booking-deposit-body]")?.textContent?.trim() || "";
  const summaryDurationTemplate = document.querySelector<HTMLElement>("[data-booking-summary-duration]")?.textContent?.trim() || "";
  const summaryBalanceTemplate = document.querySelector<HTMLElement>("[data-booking-summary-balance]")?.textContent?.trim() || "";
  const confirmedReferenceTemplate = document.querySelector<HTMLElement>("[data-booking-confirmed-reference]")?.textContent?.trim() || "";
  const confirmedBodyTemplate = document.querySelector<HTMLElement>("[data-booking-confirmed-body]")?.textContent?.trim() || "";
  const confirmedBalanceTemplate = document.querySelector<HTMLElement>("[data-booking-confirmed-balance]")?.textContent?.trim() || "";
  const confirmedEmailHeadersTemplate = document.querySelector<HTMLElement>("[data-booking-confirmed-email-headers]")?.textContent?.trim() || "";
  const confirmedEmailGreetingTemplate = document.querySelector<HTMLElement>("[data-booking-confirmed-email-greeting]")?.textContent?.trim() || "";
  const confirmedEmailSittingTemplate = document.querySelector<HTMLElement>("[data-booking-confirmed-email-sitting]")?.textContent?.trim() || "";
  const confirmedEmailLedgerTemplate = document.querySelector<HTMLElement>("[data-booking-confirmed-email-ledger]")?.textContent?.trim() || "";
  const availabilityLoadingCopy = slotStatus?.textContent?.trim() || "";
  const accessStorageKey = "vera-solaro:booking-access";

  let catalog: UnknownRecord = {};
  let selectedStartAt = "";
  let selectedSlotLabel = "";
  const initialCalendarDate = new Date();
  let calendarMonth = new Date(initialCalendarDate.getFullYear(), initialCalendarDate.getMonth(), 1);
  let calendarSlots: UnknownRecord[] = [];
  let calendarSlotsByDay = new Map<string, UnknownRecord[]>();
  let selectedCalendarDay = "";
  let placeSelectionToken = "";
  let placeSessionToken = crypto.randomUUID();
  let placeRequestSequence = 0;
  let placeDetailsSequence = 0;
  let availabilitySequence = 0;
  let bookingId = "";
  let manageToken = "";
  let holdExpiresAt = "";
  let bookingSnapshot: UnknownRecord = {};
  let currentQuote: UnknownRecord = {};
  let customerName = "";
  let customerEmail = "";
  let customerTimezone = "";
  let birthTimeWasUnknown = false;
  let payNowCents = 8_000;
  let currency = "USD";
  let holdTimer = 0;
  let paymentInFlight = false;
  let expiryCheckInFlight = false;
  let statusPollActive = false;
  let statusPollRetry = 0;
  let bookingStartedTracked = false;
  let authoritativePaymentOption: "deposit" | "full" = "deposit";
  let schedulingRetryActive = false;
  let schedulingRetryAttemptedAt = 0;
  let stripeClient: Stripe | null = null;
  let cardElement: StripeCardElement | null = null;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const selectedInput = (name: string) =>
    bookingForm?.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`) ?? null;
  const input = (name: string) => bookingForm?.elements.namedItem(name) as HTMLInputElement | null;
  const textarea = (name: string) => bookingForm?.elements.namedItem(name) as HTMLTextAreaElement | null;
  const selectedService = () => selectedInput("service")?.value || "";
  const selectedMode = () => selectedInput("meeting")?.value === "room" ? "in_person" : selectedInput("meeting")?.value || "";
  const selectedPaymentOption = () => selectedInput("payment-amount")?.value === "full" ? "full" : "deposit";
  const birthTimeApproximationValues = new Set([
    "Small hours",
    "Morning",
    "Around midday",
    "Afternoon",
    "Evening",
    "No idea at all",
  ]);
  const selectedTimezone = () => {
    const value = selectedInput("timezone")?.value || "";
    return ["Europe/Rome", "Europe/London", "America/New_York", "America/Los_Angeles"].includes(value)
      ? value
      : "";
  };

  const serviceRow = (slug = selectedService()) =>
    asRecords(catalog.services).find((service) => asText(service.slug) === slug) ?? {};
  const serviceLabel = (slug = selectedService()) =>
    asText(serviceRow(slug).name) || selectedInput("service")?.nextElementSibling?.textContent?.trim() || "";
  const formatMoney = (cents: number, code = currency) => {
    const fractionDigits = Math.abs(cents) % 100 === 0 ? 0 : 2;
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: code,
      minimumFractionDigits: fractionDigits,
      maximumFractionDigits: fractionDigits,
    }).format(cents / 100);
  };
  const fillTemplate = (template: string, values: Record<string, string>) =>
    template.replace(/\{\{\s*([a-z_]+)\s*\}\}/gi, (_token, key: string) => values[key] ?? "");
  const setText = (selector: string, value: string) => {
    const element = document.querySelector<HTMLElement>(selector);
    if (element) element.textContent = value;
  };

  const showPaymentAlert = (name: "declined" | "slot-taken" | null) => {
    if (declinedState) declinedState.hidden = name !== "declined";
    if (takenState) takenState.hidden = name !== "slot-taken";
  };

  const hideStandaloneStates = () => {
    if (waitlistState) waitlistState.hidden = true;
    if (expiredState) expiredState.hidden = true;
    if (processingState) processingState.hidden = true;
  };

  const showBookingStep = (step: number, track = true) => {
    hideStandaloneStates();
    if (bookingConfirmed) bookingConfirmed.hidden = true;
    let activePanel: HTMLElement | undefined;
    bookingSteps.forEach((panel) => {
      const active = Number(panel.dataset.bookingStep) === step;
      panel.hidden = !active;
      if (active) activePanel = panel;
    });
    bookingProgress.forEach((item) => {
      item.toggleAttribute("data-active", Number(item.dataset.bookingProgress) === step);
    });
    if (step !== 3) showPaymentAlert(null);
    window.scrollTo({ top: bookingForm?.offsetTop ?? 0, behavior: reduceMotion ? "auto" : "smooth" });
    if (track) {
      window.requestAnimationFrame(() => {
        activePanel?.querySelector<HTMLElement>("input:not([disabled]), button:not([disabled]), a[href], textarea:not([disabled])")
          ?.focus({ preventScroll: true });
      });
    }
    if (track && !bookingStartedTracked) {
      bookingStartedTracked = true;
      window.astroPagesTrack?.("booking_started", { step });
    }
  };

  const startProcessing = () => {
    paymentInFlight = true;
    window.clearInterval(holdTimer);
    if (processingState) processingState.hidden = false;
  };
  const stopProcessing = (resumeHold = true) => {
    paymentInFlight = false;
    if (processingState) processingState.hidden = true;
    if (resumeHold && holdExpiresAt && new Date(holdExpiresAt).getTime() > Date.now()) startHoldTimer();
  };

  const normalizeBirthDate = (value: string) => {
    const trimmed = value.trim();
    const iso = trimmed.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    const european = trimmed.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    const parts = iso ? [iso[1], iso[2], iso[3]] : european ? [european[3], european[2], european[1]] : [];
    if (!parts.length) return "";
    const normalized = `${parts[0]}-${parts[1].padStart(2, "0")}-${parts[2].padStart(2, "0")}`;
    const parsed = new Date(`${normalized}T00:00:00Z`);
    return Number.isFinite(parsed.getTime()) && parsed.toISOString().startsWith(normalized) ? normalized : "";
  };

  const normalizeBirthTime = (value: string) => {
    const match = value.trim().match(/^(\d{1,2}):(\d{2})$/);
    if (!match) return "";
    const hour = Number(match[1]);
    const minute = Number(match[2]);
    return hour >= 0 && hour <= 23 && minute >= 0 && minute <= 59
      ? `${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}`
      : "";
  };

  const clearPlaceSelection = () => {
    placeSelectionToken = "";
    placeDetailsSequence += 1;
    const resolved = document.querySelector<HTMLElement>("[data-booking-place-resolved]");
    if (resolved) resolved.hidden = true;
  };

  const showPlaceError = (visible: boolean) => {
    const error = document.querySelector<HTMLElement>("[data-booking-place-error]");
    if (error) error.hidden = !visible;
  };

  const resolvePlace = async (placeId: string, description: string) => {
    const birthDate = normalizeBirthDate(input("birth-date")?.value || "");
    const unknownTime = input("birth-time-unknown")?.checked === true;
    const birthTime = unknownTime ? "" : normalizeBirthTime(input("birth-time")?.value || "");
    if (!birthDate || (!unknownTime && !birthTime)) {
      showPlaceError(true);
      (birthDate ? input("birth-time") : input("birth-date"))?.focus();
      return;
    }
    const sequence = ++placeDetailsSequence;
    try {
      const data = await requestJson(`${apiBase}/places/details`, {
        method: "POST",
        body: JSON.stringify({
          placeId,
          sessionToken: placeSessionToken,
          birthDate,
          birthTime,
          birthTimeUnknown: unknownTime,
        }),
      });
      if (sequence !== placeDetailsSequence) return;
      const place = asRecord(data.place);
      placeSelectionToken = asText(data.selectionToken);
      const address = asText(place.formattedAddress) || description;
      const placeInput = input("birth-place");
      if (placeInput) placeInput.value = address;
      const suggestions = document.querySelector<HTMLElement>("[data-booking-place-suggestions]");
      if (suggestions) suggestions.hidden = true;
      const label = document.querySelector<HTMLElement>("[data-booking-place-resolved-label]");
      if (label) label.textContent = address;
      const resolved = document.querySelector<HTMLElement>("[data-booking-place-resolved]");
      if (resolved) resolved.hidden = false;
      showPlaceError(!placeSelectionToken);
      placeSessionToken = crypto.randomUUID();
    } catch {
      if (sequence !== placeDetailsSequence) return;
      clearPlaceSelection();
      showPlaceError(true);
    }
  };

  const loadPlaceSuggestions = async () => {
    const placeInput = input("birth-place");
    const suggestions = document.querySelector<HTMLElement>("[data-booking-place-suggestions]");
    if (!placeInput || !suggestions) return;
    const query = placeInput.value.trim();
    clearPlaceSelection();
    suggestions.replaceChildren();
    if (query.length < 2) {
      suggestions.hidden = true;
      return;
    }
    const sequence = ++placeRequestSequence;
    try {
      const params = new URLSearchParams({ input: query, sessionToken: placeSessionToken, language: "en" });
      const data = await requestJson(`${apiBase}/places/autocomplete?${params}`);
      if (sequence !== placeRequestSequence) return;
      for (const prediction of asRecords(data.predictions)) {
        const placeId = asText(prediction.placeId);
        const description = asText(prediction.description);
        if (!placeId || !description) continue;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "vera-button vera-button--paper vera-button--small";
        button.textContent = description;
        button.addEventListener("click", () => void resolvePlace(placeId, description));
        suggestions.append(button);
      }
      suggestions.hidden = suggestions.childElementCount === 0;
      showPlaceError(false);
    } catch {
      if (sequence !== placeRequestSequence) return;
      suggestions.hidden = true;
      showPlaceError(true);
    }
  };

  let placeDebounce = 0;
  input("birth-place")?.addEventListener("input", () => {
    clearPlaceSelection();
    placeRequestSequence += 1;
    window.clearTimeout(placeDebounce);
    placeDebounce = window.setTimeout(() => void loadPlaceSuggestions(), 260);
  });
  [input("birth-date"), input("birth-time")].forEach((field) => field?.addEventListener("input", clearPlaceSelection));
  const syncUnknownBirthTime = () => {
    const unknown = input("birth-time-unknown")?.checked === true;
    const timeInput = input("birth-time");
    if (timeInput) {
      timeInput.disabled = unknown;
      if (timeInput.disabled) timeInput.value = "";
    }
    const panel = document.querySelector<HTMLElement>("[data-booking-unknown-time]");
    if (panel) panel.hidden = !unknown;
    const approximationGroup = document.querySelector<HTMLElement>("[data-booking-time-approximation]");
    const approximationChoices = Array.from(
      bookingForm?.querySelectorAll<HTMLInputElement>("input[name='birth-time-approximation']") ?? [],
    );
    approximationChoices.forEach((choice) => {
      choice.required = unknown;
      if (!unknown) choice.checked = false;
    });
    if (!unknown) approximationGroup?.removeAttribute("aria-invalid");
  };
  input("birth-time-unknown")?.addEventListener("change", () => {
    syncUnknownBirthTime();
    clearPlaceSelection();
  });
  bookingForm?.querySelectorAll<HTMLInputElement>("input[name='birth-time-approximation']").forEach((choice) => {
    choice.addEventListener("change", () => {
      document.querySelector<HTMLElement>("[data-booking-time-approximation]")?.removeAttribute("aria-invalid");
    });
  });

  const clearSlotSelection = () => {
    selectedStartAt = "";
    selectedSlotLabel = "";
    if (continueToDetails) continueToDetails.disabled = true;
    liveSlots?.querySelectorAll<HTMLInputElement>("input[name='live-slot']").forEach((slot) => {
      slot.checked = false;
    });
  };

  const slotDateLabel = (startAt: string, zone: string) =>
    new Intl.DateTimeFormat("en-US", {
      weekday: "long",
      month: "long",
      day: "numeric",
      timeZone: zone,
    }).format(new Date(startAt));
  const slotTimeLabel = (startAt: string, zone: string) =>
    new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: zone,
    }).format(new Date(startAt));

  const calendarDateKey = (startAt: string, zone: string) => {
    const parts = new Intl.DateTimeFormat("en-CA", {
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      timeZone: zone,
    }).formatToParts(new Date(startAt));
    const value = (type: Intl.DateTimeFormatPartTypes) => parts.find((part) => part.type === type)?.value || "";
    return `${value("year")}-${value("month")}-${value("day")}`;
  };

  const renderSlots = (times: UnknownRecord[], zone: string) => {
    liveSlots?.replaceChildren();
    const modeLabel = selectedInput("meeting")?.nextElementSibling?.textContent?.trim() || "";
    const duration = formatDuration(asNumber(serviceRow().durationMinutes));
    for (const slot of times) {
      const startAt = asText(slot.startAt);
      if (!startAt) continue;
      const label = document.createElement("label");
      label.className = "vera-calendar-slot";
      const radio = document.createElement("input");
      radio.type = "radio";
      radio.name = "live-slot";
      radio.value = startAt;
      const time = document.createElement("strong");
      time.textContent = slotTimeLabel(startAt, zone);
      const meta = document.createElement("span");
      meta.textContent = [modeLabel, duration].filter(Boolean).join(" · ");
      radio.addEventListener("change", () => {
        selectedStartAt = startAt;
        selectedSlotLabel = `${slotDateLabel(startAt, zone)} · ${time.textContent || ""}`;
        if (continueToDetails) continueToDetails.disabled = false;
        window.astroPagesTrack?.("slot_selected", { step: 1, service: selectedService(), mode: selectedMode() });
      });
      label.append(radio, time, meta);
      liveSlots?.append(label);
    }
  };

  const renderCalendarGrid = () => {
    if (!calendarMonthGrid) return;
    calendarMonthGrid.replaceChildren();
    const year = calendarMonth.getFullYear();
    const month = calendarMonth.getMonth();
    const monthName = new Intl.DateTimeFormat("en-US", { month: "long", year: "numeric" }).format(calendarMonth);
    if (calendarMonthLabel) calendarMonthLabel.textContent = monthName;
    const currentMonth = new Date(initialCalendarDate.getFullYear(), initialCalendarDate.getMonth(), 1);
    if (calendarPrevMonth) calendarPrevMonth.disabled = calendarMonth.getTime() <= currentMonth.getTime();
    const firstWeekday = (new Date(year, month, 1).getDay() + 6) % 7;
    const dayCount = new Date(year, month + 1, 0).getDate();
    for (let index = 0; index < firstWeekday; index += 1) {
      const spacer = document.createElement("span");
      spacer.className = "vera-calendar-day vera-calendar-day--blank";
      spacer.setAttribute("aria-hidden", "true");
      calendarMonthGrid.append(spacer);
    }
    for (let day = 1; day <= dayCount; day += 1) {
      const key = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
      const times = calendarSlotsByDay.get(key) ?? [];
      const button = document.createElement("button");
      button.type = "button";
      button.className = "vera-calendar-day";
      button.dataset.kind = times.length > 0 ? "open" : "closed";
      button.toggleAttribute("data-selected", selectedCalendarDay === key);
      button.disabled = times.length === 0;
      button.setAttribute("aria-label", times.length > 0
        ? `${day} ${monthName}, ${times.length} ${times.length === 1 ? calendarCopy.slot : calendarCopy.slots}`
        : `${day} ${monthName}, ${calendarCopy.noSittings}`);
      const number = document.createElement("strong");
      number.textContent = String(day);
      const note = document.createElement("span");
      note.textContent = times.length > 0
        ? `${times.length} ${times.length === 1 ? calendarCopy.slot : calendarCopy.slots}`
        : "—";
      button.append(number, note);
      button.addEventListener("click", () => {
        selectedCalendarDay = key;
        clearSlotSelection();
        renderCalendarGrid();
        renderSlots(times, selectedTimezone());
        if (calendarDayLabel) calendarDayLabel.textContent = slotDateLabel(asText(times[0]?.startAt), selectedTimezone());
        if (calendarDayCount) {
          const zoneLabel = selectedInput("timezone")?.nextElementSibling?.textContent?.trim() || "";
          const countCopy = times.length === 1 ? calendarCopy.hour : calendarCopy.hours;
          calendarDayCount.textContent = `${times.length} ${countCopy}${zoneLabel ? ` · ${zoneLabel} ${calendarCopy.time}` : ""}`;
        }
        if (calendarDayHours) calendarDayHours.hidden = false;
        if (calendarPrompt) calendarPrompt.hidden = true;
      });
      calendarMonthGrid.append(button);
    }
  };

  const groupCalendarSlots = () => {
    calendarSlotsByDay = new Map<string, UnknownRecord[]>();
    const zone = selectedTimezone();
    for (const slot of calendarSlots) {
      const startAt = asText(slot.startAt);
      if (!startAt || !zone) continue;
      const key = calendarDateKey(startAt, zone);
      const times = calendarSlotsByDay.get(key) ?? [];
      times.push(slot);
      calendarSlotsByDay.set(key, times);
    }
    for (const times of calendarSlotsByDay.values()) {
      times.sort((left, right) => new Date(asText(left.startAt)).getTime() - new Date(asText(right.startAt)).getTime());
    }
    selectedCalendarDay = "";
    clearSlotSelection();
    if (calendarDayHours) calendarDayHours.hidden = true;
    if (calendarPrompt) calendarPrompt.hidden = false;
    renderCalendarGrid();
  };

  const loadAvailability = async () => {
    const service = selectedService();
    const mode = selectedMode();
    const zone = selectedTimezone();
    calendarSlots = [];
    calendarSlotsByDay = new Map<string, UnknownRecord[]>();
    selectedCalendarDay = "";
    clearSlotSelection();
    liveSlots?.replaceChildren();
    if (calendarDayHours) calendarDayHours.hidden = true;
    if (calendarPrompt) calendarPrompt.hidden = false;
    renderCalendarGrid();
    waitlistOpenButtons.forEach((button) => (button.hidden = true));
    if (!service || !mode || !zone) {
      if (slotStatus) slotStatus.textContent = availabilityLoadingCopy;
      return;
    }
    const sequence = ++availabilitySequence;
    calendarMonthGrid?.setAttribute("aria-busy", "true");
    if (slotStatus) {
      slotStatus.hidden = false;
      slotStatus.textContent = availabilityLoadingCopy;
    }
    try {
      let activeWaitlistCount = 0;
      const monthStart = Date.UTC(calendarMonth.getFullYear(), calendarMonth.getMonth(), 1) - 14 * 60 * 60_000;
      const monthEnd = Date.UTC(calendarMonth.getFullYear(), calendarMonth.getMonth() + 1, 1) + 14 * 60 * 60_000;
      let cursor = Math.max(Date.now() + 5 * 60_000, monthStart);
      const byStart = new Map<string, UnknownRecord>();
      while (cursor < monthEnd) {
        const endValue = Math.min(cursor + 7 * 24 * 60 * 60_000, monthEnd);
        const start = new Date(cursor);
        const end = new Date(endValue);
        const params = new URLSearchParams({
          serviceSlug: service,
          mode,
          start: start.toISOString(),
          end: end.toISOString(),
        });
        const data = await requestJson(`${apiBase}/availability?${params}`);
        if (sequence !== availabilitySequence) return;
        activeWaitlistCount = Math.max(activeWaitlistCount, asNumber(data.activeWaitlistCount));
        for (const slot of asRecords(data.times)) {
          const startAt = asText(slot.startAt);
          if (startAt) byStart.set(startAt, slot);
        }
        cursor = endValue;
      }
      calendarSlots = [...byStart.values()];
      groupCalendarSlots();
      if (slotStatus) {
        slotStatus.hidden = calendarSlots.length > 0;
        slotStatus.textContent = calendarSlots.length > 0 ? availabilityLoadingCopy : slotMount?.dataset.emptyCopy || availabilityLoadingCopy;
      }
      waitlistOpenButtons.forEach((button) => (button.hidden = calendarSlots.length > 0));
      const waitStat = waitlistState?.querySelector<HTMLElement>(".vera-stat strong");
      if (waitStat && activeWaitlistCount > 0) waitStat.textContent = String(activeWaitlistCount);
    } catch {
      if (sequence !== availabilitySequence) return;
      calendarSlots = [];
      groupCalendarSlots();
      if (slotStatus) {
        slotStatus.hidden = false;
        slotStatus.textContent = slotMount?.dataset.errorCopy || availabilityLoadingCopy;
      }
      waitlistOpenButtons.forEach((button) => (button.hidden = false));
    } finally {
      if (sequence === availabilitySequence) calendarMonthGrid?.setAttribute("aria-busy", "false");
    }
  };

  calendarPrevMonth?.addEventListener("click", () => {
    const currentMonth = new Date(initialCalendarDate.getFullYear(), initialCalendarDate.getMonth(), 1);
    const previous = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() - 1, 1);
    if (previous.getTime() < currentMonth.getTime()) return;
    calendarMonth = previous;
    void loadAvailability();
  });
  calendarNextMonth?.addEventListener("click", () => {
    calendarMonth = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() + 1, 1);
    void loadAvailability();
  });

  bookingForm?.querySelectorAll<HTMLInputElement>("input[name='service'], input[name='meeting']")
    .forEach((field) => field.addEventListener("change", () => {
      if (field.name === "meeting") {
        window.astroPagesTrack?.("mode_selected", { mode: selectedMode() });
      }
      void loadAvailability();
    }));
  bookingForm?.querySelectorAll<HTMLInputElement>("input[name='timezone']").forEach((field) => {
    field.addEventListener("change", groupCalendarSlots);
  });

  const rememberBookingAccess = () => {
    if (!bookingId || !manageToken) return;
    try {
      sessionStorage.setItem(accessStorageKey, JSON.stringify({
        bookingId,
        manageToken,
        holdExpiresAt,
        customerTimezone,
        paymentOption: authoritativePaymentOption,
      }));
    } catch {
      // The current page retains the opaque token when storage is unavailable.
    }
  };

  const forgetBookingAccess = () => {
    try {
      sessionStorage.removeItem(accessStorageKey);
    } catch {
      // Nothing else is persisted.
    }
  };

  const restoreBookingAccess = () => {
    try {
      const stored = asRecord(JSON.parse(sessionStorage.getItem(accessStorageKey) || "{}"));
      bookingId = asText(stored.bookingId);
      manageToken = asText(stored.manageToken);
      holdExpiresAt = asText(stored.holdExpiresAt);
      customerTimezone = asText(stored.customerTimezone);
      authoritativePaymentOption = asText(stored.paymentOption) === "full" ? "full" : "deposit";
    } catch {
      bookingId = "";
      manageToken = "";
      holdExpiresAt = "";
      customerName = "";
      customerEmail = "";
      customerTimezone = "";
      birthTimeWasUnknown = false;
      authoritativePaymentOption = "deposit";
    }
  };

  const restoreSafeBirthTime = (booking: UnknownRecord) => {
    if (!Object.prototype.hasOwnProperty.call(booking, "birthTimeUnknown")) return;
    birthTimeWasUnknown = booking.birthTimeUnknown === true;
    const unknownChoice = input("birth-time-unknown");
    if (unknownChoice) unknownChoice.checked = birthTimeWasUnknown;
    const approximation = asText(booking.birthTimeApproximation);
    bookingForm?.querySelectorAll<HTMLInputElement>("input[name='birth-time-approximation']").forEach((choice) => {
      choice.checked = birthTimeWasUnknown && birthTimeApproximationValues.has(approximation) && choice.value === approximation;
    });
    syncUnknownBirthTime();
  };

  const setHoldLabel = () => {
    const remaining = Math.max(0, new Date(holdExpiresAt).getTime() - Date.now());
    const minutes = Math.floor(remaining / 60_000);
    const seconds = Math.floor((remaining % 60_000) / 1_000);
    document.querySelectorAll<HTMLElement>("[data-booking-hold-label]").forEach((label) => {
      label.textContent = `${minutes}:${String(seconds).padStart(2, "0")}`;
    });
    if (bookingHold) bookingHold.hidden = !holdExpiresAt || remaining <= 0;
    if (holdExpiresAt && remaining <= 0 && !paymentInFlight && !expiryCheckInFlight) {
      expiryCheckInFlight = true;
      void statusForBooking()
        .then((data) => {
          const booking = asRecord(data.booking);
          bookingSnapshot = booking;
          holdExpiresAt = asText(booking.holdExpiresAt) || holdExpiresAt;
          rememberBookingAccess();
          if (["expired", "cancelled"].includes(asText(booking.status))) showExpired();
          else if (new Date(holdExpiresAt).getTime() > Date.now()) startHoldTimer();
        })
        .catch(() => undefined)
        .finally(() => {
          expiryCheckInFlight = false;
        });
    }
  };

  const startHoldTimer = () => {
    window.clearInterval(holdTimer);
    if (paymentInFlight) return;
    setHoldLabel();
    holdTimer = window.setInterval(setHoldLabel, 1_000);
  };

  const showExpired = () => {
    window.clearInterval(holdTimer);
    stopProcessing(false);
    if (bookingHold) bookingHold.hidden = true;
    bookingSteps.forEach((panel) => (panel.hidden = true));
    if (bookingConfirmed) bookingConfirmed.hidden = true;
    if (waitlistState) waitlistState.hidden = true;
    if (expiredState) expiredState.hidden = false;
    const reading = document.querySelector<HTMLElement>("[data-booking-expired-reading]");
    const chart = document.querySelector<HTMLElement>("[data-booking-expired-chart]");
    const hour = document.querySelector<HTMLElement>("[data-booking-expired-hour]");
    if (reading) reading.textContent = serviceLabel(asText(bookingSnapshot.serviceSlug));
    if (chart) chart.textContent = customerName || input("full-name")?.value || "";
    if (hour) hour.textContent = selectedSlotLabel || asText(bookingSnapshot.selectedStartAt);
    forgetBookingAccess();
    window.requestAnimationFrame(() => {
      const heading = expiredState?.querySelector<HTMLElement>("h2");
      heading?.setAttribute("tabindex", "-1");
      heading?.focus({ preventScroll: true });
    });
  };

  const mountStripeCard = async (key = asText(catalog.stripePublishableKey)) => {
    if (!key || !stripeMount || cardElement) return;
    stripeClient = await loadStripe(key);
    if (!stripeClient) return;
    cardElement = stripeClient.elements().create("card", {
      hidePostalCode: false,
      style: {
        base: {
          color: "#2C1810",
          fontFamily: "Georgia, serif",
          fontSize: "16px",
          "::placeholder": { color: "#7A5A44" },
        },
        invalid: { color: "#C6491F" },
      },
    });
    if (stripeFallback) stripeFallback.hidden = true;
    cardElement.mount(stripeMount);
  };

  const bookingService = () => serviceRow(asText(bookingSnapshot.serviceSlug) || selectedService());
  const bookingMode = () => asText(bookingSnapshot.mode) || selectedMode();
  const bookingZone = () => customerTimezone || selectedTimezone() || "Europe/Rome";
  const zoneLabel = () => {
    const choice = bookingForm?.querySelector<HTMLInputElement>(
      `input[name="timezone"][value="${CSS.escape(bookingZone())}"]`,
    );
    return choice?.nextElementSibling?.textContent?.trim() || bookingZone();
  };
  const formatDuration = (minutes: number) => {
    if (minutes <= 0) return "";
    const templates = summaryDurationTemplate.split("\n");
    const usesHours = minutes % 60 === 0;
    const count = usesHours ? minutes / 60 : minutes;
    const unitTemplate = usesHours
      ? templates[count === 1 ? 3 : 4]
      : templates[count === 1 ? 1 : 2];
    const duration = fillTemplate(unitTemplate || "", { count: String(count) });
    return fillTemplate(templates[0] || "", { duration });
  };
  const sittingDate = () => {
    const value = asText(bookingSnapshot.selectedStartAt) || selectedStartAt;
    const parsed = new Date(value);
    return Number.isFinite(parsed.getTime()) ? parsed : null;
  };
  const sittingWhen = () => {
    const parsed = sittingDate();
    if (!parsed) return "";
    const zone = bookingZone();
    const date = new Intl.DateTimeFormat("en-US", {
      weekday: "long",
      month: "long",
      day: "numeric",
      year: "numeric",
      timeZone: zone,
    }).format(parsed);
    const time = new Intl.DateTimeFormat("en-US", {
      hour: "numeric",
      minute: "2-digit",
      timeZone: zone,
    }).format(parsed);
    return `${date} · ${time} ${zoneLabel()}`;
  };
  const shortSittingDate = () => {
    const parsed = sittingDate();
    return parsed
      ? new Intl.DateTimeFormat("en-US", {
          weekday: "long",
          month: "long",
          day: "numeric",
          year: "numeric",
          timeZone: bookingZone(),
        }).format(parsed)
      : "";
  };
  const summaryModeCopy = () => {
    const mode = bookingMode();
    document.querySelectorAll<HTMLElement>("[data-booking-summary-mode]").forEach((element) => {
      element.hidden = element.dataset.bookingSummaryMode !== mode;
    });
    return document.querySelector<HTMLElement>(`[data-booking-summary-mode="${mode}"]`)?.textContent?.trim() || "";
  };
  const summaryTimeSuffix = () =>
    document.querySelector<HTMLElement>("[data-booking-summary-when]")?.nextElementSibling?.textContent?.trim() || "";
  const chartName = () => customerName.trim();
  const chartSummary = () => {
    const name = chartName();
    const suffix = document.querySelector<HTMLElement>("[data-booking-summary-unknown]")?.textContent || "";
    return name ? `${name}${birthTimeWasUnknown ? suffix : ""}` : "";
  };
  const quoteNumber = (key: string, fallback: number) =>
    Object.prototype.hasOwnProperty.call(currentQuote, key) ? asNumber(currentQuote[key]) : fallback;

  const renderPaymentSummary = () => {
    const service = bookingService();
    const price = quoteNumber("priceCents", asNumber(bookingSnapshot.priceCents) || asNumber(service.priceCents));
    const gift = quoteNumber("giftAppliedCents", asNumber(bookingSnapshot.giftAppliedCents));
    const totalDue = quoteNumber("totalDueCents", Math.max(0, price - gift));
    const dueNow = quoteNumber("payNowCents", payNowCents);
    const later = Math.max(0, totalDue - dueNow);
    const deposit = Math.min(asNumber(catalog.depositCents), totalDue);
    const depositBalance = Math.max(0, totalDue - deposit);
    const mode = bookingMode();

    setText("[data-booking-summary-service]", asText(service.name));
    setText("[data-booking-summary-duration]", formatDuration(asNumber(service.durationMinutes)));
    summaryModeCopy();
    setText("[data-booking-summary-when]", sittingWhen());
    setText("[data-booking-summary-chart]", chartName());
    const unknown = document.querySelector<HTMLElement>("[data-booking-summary-unknown]");
    if (unknown) unknown.hidden = !birthTimeWasUnknown || !chartName();
    setText("[data-booking-summary-price]", formatMoney(price));
    const giftRow = document.querySelector<HTMLElement>("[data-booking-summary-gift]");
    if (giftRow) giftRow.hidden = gift <= 0;
    setText("[data-booking-summary-gift-value]", gift > 0 ? formatMoney(-gift) : "");
    setText("[data-booking-summary-due]", formatMoney(dueNow));
    const balance = document.querySelector<HTMLElement>("[data-booking-summary-balance]");
    if (balance) {
      balance.hidden = later <= 0;
      balance.textContent = fillTemplate(summaryBalanceTemplate, { balance: formatMoney(later) });
    }
    setText("[data-booking-deposit-amount]", formatMoney(deposit));
    setText("[data-booking-full-amount]", formatMoney(totalDue));
    const depositBody = document.querySelector<HTMLElement>("[data-booking-deposit-body]");
    if (depositBody) {
      depositBody.textContent = fillTemplate(depositBodyTemplate, { balance: formatMoney(depositBalance) });
    }
    const applied = document.querySelector<HTMLElement>("[data-booking-gift-applied]");
    if (applied) applied.hidden = gift <= 0;
    setText("[data-booking-gift-amount]", gift > 0 ? formatMoney(gift) : "");
    if (mode) summaryModeCopy();
  };

  const renderConfirmation = (booking: UnknownRecord) => {
    const service = serviceRow(asText(booking.serviceSlug));
    const reference = asText(booking.bookingNumber);
    const paid = asNumber(booking.paidCents);
    const balance = asNumber(booking.balanceCents);
    const when = sittingWhen();
    const fullWhen = [when, summaryTimeSuffix()].filter(Boolean).join(" ");
    const mode = summaryModeCopy();
    const values = {
      reference,
      email: customerEmail,
      first_name: customerName.trim().split(/\s+/)[0] || "",
      short_when: shortSittingDate(),
      service: asText(service.name),
      when: fullWhen,
      chart: chartSummary(),
      paid: formatMoney(paid, asText(booking.currency) || currency),
      balance: formatMoney(balance, asText(booking.currency) || currency),
    };

    const referenceNode = document.querySelector<HTMLElement>("[data-booking-confirmed-reference]");
    if (referenceNode) {
      referenceNode.hidden = !reference;
      referenceNode.textContent = fillTemplate(confirmedReferenceTemplate, values);
    }
    const body = document.querySelector<HTMLElement>("[data-booking-confirmed-body]");
    if (body) {
      body.hidden = !customerEmail;
      body.textContent = fillTemplate(confirmedBodyTemplate, values);
    }
    setText("[data-booking-confirmed-service]", asText(service.name));
    setText("[data-booking-confirmed-when]", when);
    setText("[data-booking-confirmed-mode]", mode);
    setText("[data-booking-confirmed-paid]", values.paid);
    const balanceNode = document.querySelector<HTMLElement>("[data-booking-confirmed-balance]");
    if (balanceNode) {
      balanceNode.hidden = balance <= 0;
      balanceNode.textContent = fillTemplate(confirmedBalanceTemplate, values);
    }
    const unknownNote = document.querySelector<HTMLElement>("[data-booking-confirmed-unknown]");
    if (unknownNote) unknownNote.hidden = !birthTimeWasUnknown;

    const emailPreview = document.querySelector<HTMLElement>("[data-booking-confirmed-email]");
    if (emailPreview) emailPreview.hidden = !customerEmail;
    setText("[data-booking-confirmed-email-headers]", fillTemplate(confirmedEmailHeadersTemplate, values));
    setText("[data-booking-confirmed-email-greeting]", fillTemplate(confirmedEmailGreetingTemplate, values));
    const emailSittingLines = confirmedEmailSittingTemplate.split("\n");
    const selectedModeLine = bookingMode() === "in_person" ? emailSittingLines[2] : emailSittingLines[1];
    setText(
      "[data-booking-confirmed-email-sitting]",
      fillTemplate([emailSittingLines[0], selectedModeLine].filter(Boolean).join(" "), values),
    );
    const ledger = document.querySelector<HTMLElement>("[data-booking-confirmed-email-ledger]");
    if (ledger) {
      ledger.replaceChildren();
      confirmedEmailLedgerTemplate.split("\n").forEach((line, index) => {
        if ((index === 1 && !values.chart) || (index === 3 && balance <= 0)) return;
        const row = document.createElement("div");
        row.textContent = fillTemplate(line, values);
        ledger.append(row);
      });
    }
  };

  const updateSubmitAmount = (cents: number, code = currency) => {
    payNowCents = Math.max(0, cents);
    currency = code || currency;
    if (submitButton && submitCtaTemplate) {
      submitButton.textContent = fillTemplate(submitCtaTemplate, { due_now: formatMoney(payNowCents, currency) });
    }
    renderPaymentSummary();
  };

  const showIntakeError = (name: string, visible: boolean) => {
    const error = document.querySelector<HTMLElement>(`[data-booking-intake-error="${name}"]`);
    if (error) error.hidden = !visible;
  };
  const intakeFields = ["full-name", "email", "birth-date", "consent"];
  intakeFields.forEach((name) => {
    const field = input(name);
    field?.addEventListener(field.type === "checkbox" ? "change" : "input", () => {
      showIntakeError(name === "full-name" ? "name" : name, false);
    });
  });

  const validateIntake = () => {
    document.querySelectorAll<HTMLElement>("[data-booking-intake-error]").forEach((error) => {
      error.hidden = true;
    });
    const nameField = input("full-name");
    const emailField = input("email");
    const birthDateField = input("birth-date");
    const consentField = input("consent");
    const birthDate = normalizeBirthDate(input("birth-date")?.value || "");
    const birthTimeUnknown = input("birth-time-unknown")?.checked === true;
    const birthTime = birthTimeUnknown ? "" : normalizeBirthTime(input("birth-time")?.value || "");
    const birthTimeApproximation = selectedInput("birth-time-approximation")?.value || "";
    const invalid = [
      { key: "name", field: nameField, invalid: (nameField?.value.trim().length || 0) < 2 },
      { key: "email", field: emailField, invalid: !emailField?.value.trim() || !emailField.validity.valid },
      { key: "birth-date", field: birthDateField, invalid: !birthDate },
      { key: "consent", field: consentField, invalid: consentField?.checked !== true },
    ].filter((entry) => entry.invalid);
    invalid.forEach((entry) => showIntakeError(entry.key, true));
    if (invalid.length > 0) {
      invalid[0]?.field?.focus();
      return null;
    }
    if (!birthTimeUnknown && !birthTime) {
      input("birth-time")?.focus();
      return null;
    }
    if (birthTimeUnknown && !birthTimeApproximationValues.has(birthTimeApproximation)) {
      const approximationGroup = document.querySelector<HTMLElement>("[data-booking-time-approximation]");
      approximationGroup?.setAttribute("aria-invalid", "true");
      bookingForm?.querySelector<HTMLInputElement>("input[name='birth-time-approximation']")?.focus();
      return null;
    }
    document.querySelector<HTMLElement>("[data-booking-time-approximation]")?.removeAttribute("aria-invalid");
    if (!placeSelectionToken) {
      showPlaceError(true);
      input("birth-place")?.focus();
      return null;
    }
    return {
      birthDate,
      birthTime,
      birthTimeUnknown,
      ...(birthTimeUnknown ? { birthTimeApproximation } : {}),
    };
  };

  const createBookingHold = async () => {
    if (bookingId && manageToken) return true;
    const intake = validateIntake();
    if (!intake || !selectedStartAt || !selectedService() || !selectedMode() || !selectedTimezone()) return false;
    customerName = input("full-name")?.value.trim() || "";
    customerEmail = input("email")?.value.trim() || "";
    customerTimezone = selectedTimezone();
    birthTimeWasUnknown = intake.birthTimeUnknown;
    startProcessing();
    try {
      const idempotencyKey = `vera-${crypto.randomUUID().replaceAll("-", "")}`;
      const data = await requestJson(`${apiBase}/bookings`, {
        method: "POST",
        body: JSON.stringify({
          idempotencyKey,
          serviceSlug: selectedService(),
          mode: selectedMode(),
          startAt: selectedStartAt,
          name: input("full-name")?.value || "",
          email: input("email")?.value || "",
          timezone: selectedTimezone(),
          paymentOption: selectedPaymentOption(),
          consentContact: input("consent")?.checked === true,
          intake: {
            ...intake,
            placeSelectionToken,
            focus: textarea("intention")?.value || "",
          },
        }),
      });
      bookingSnapshot = asRecord(data.booking);
      bookingId = asText(bookingSnapshot.id);
      manageToken = asText(data.manageToken);
      holdExpiresAt = asText(data.holdExpiresAt) || asText(bookingSnapshot.holdExpiresAt);
      currentQuote = {
        priceCents: asNumber(bookingSnapshot.priceCents),
        giftAppliedCents: asNumber(bookingSnapshot.giftAppliedCents),
        totalDueCents: Math.max(0, asNumber(bookingSnapshot.priceCents) - asNumber(bookingSnapshot.giftAppliedCents)),
        payNowCents: asNumber(data.payNowCents),
      };
      authoritativePaymentOption = asText(bookingSnapshot.paymentOption) === "full" ? "full" : "deposit";
      updateSubmitAmount(asNumber(data.payNowCents), asText(bookingSnapshot.currency) || "USD");
      if (!bookingId || !manageToken) throw new RequestFailure(500);
      rememberBookingAccess();
      startHoldTimer();
      showBookingStep(3);
      try {
        await mountStripeCard();
      } catch {
        if (stripeFallback) stripeFallback.hidden = false;
      }
      window.astroPagesTrack?.("intake_completed", { step: 2, service: selectedService(), mode: selectedMode() });
      return true;
    } catch (error) {
      const failure = error instanceof RequestFailure ? error : new RequestFailure(500);
      if (failure.status === 409) {
        showBookingStep(3);
        showPaymentAlert("slot-taken");
      } else {
        showBookingStep(1, false);
        if (slotStatus) {
          slotStatus.hidden = false;
          slotStatus.textContent = slotMount?.dataset.errorCopy || availabilityLoadingCopy;
        }
      }
      return false;
    } finally {
      stopProcessing();
    }
  };

  const updateBookingQuote = async ({ giftCode, removeGift = false }: { giftCode?: string; removeGift?: boolean } = {}) => {
    if (!bookingId || !manageToken) return null;
    const data = await requestJson(`${apiBase}/bookings/${encodeURIComponent(bookingId)}/quote`, {
      method: "POST",
      body: JSON.stringify({
        manageToken,
        paymentOption: selectedPaymentOption(),
        ...(giftCode ? { giftCode } : {}),
        ...(removeGift ? { removeGift: true } : {}),
      }),
    });
    bookingSnapshot = asRecord(data.booking);
    authoritativePaymentOption = asText(bookingSnapshot.paymentOption) === "full" ? "full" : "deposit";
    const quote = asRecord(data.quote);
    currentQuote = quote;
    rememberBookingAccess();
    updateSubmitAmount(asNumber(quote.payNowCents), asText(quote.currency) || currency);
    if (quote.fullyGifted === true) {
      startProcessing();
      void pollBookingStatus();
    }
    return quote;
  };

  bookingForm?.querySelectorAll<HTMLInputElement>("input[name='payment-amount']").forEach((choice) => {
    choice.addEventListener("change", async () => {
      const choices = Array.from(bookingForm?.querySelectorAll<HTMLInputElement>("input[name='payment-amount']") ?? []);
      choices.forEach((field) => (field.disabled = true));
      try {
        await updateBookingQuote();
      } catch {
        const authoritative = choices.find((field) => field.value === authoritativePaymentOption);
        if (authoritative) authoritative.checked = true;
        renderPaymentSummary();
      } finally {
        choices.forEach((field) => (field.disabled = false));
      }
    });
  });

  document.querySelector<HTMLButtonElement>("[data-booking-gift-apply]")?.addEventListener("click", async () => {
    const giftInput = input("gift");
    const code = giftInput?.value.trim() || "";
    const error = document.querySelector<HTMLElement>("[data-booking-gift-error]");
    const applied = document.querySelector<HTMLElement>("[data-booking-gift-applied]");
    try {
      const quote = await updateBookingQuote(code ? { giftCode: code } : { removeGift: true });
      const amount = asNumber(quote?.giftAppliedCents);
      if (error) error.hidden = true;
      if (applied) applied.hidden = amount <= 0;
      const amountNode = document.querySelector<HTMLElement>("[data-booking-gift-amount]");
      if (amountNode) amountNode.textContent = amount > 0 ? formatMoney(amount) : "";
    } catch {
      if (error) error.hidden = false;
      if (applied) applied.hidden = true;
    }
  });

  const statusForBooking = async () => requestJson(
    `${apiBase}/bookings/${encodeURIComponent(bookingId)}/status`,
    { headers: { authorization: `Bearer ${manageToken}` } },
  );

  const retryPaidScheduling = async () => {
    if (schedulingRetryActive || !bookingId || !manageToken) return;
    if (Date.now() - schedulingRetryAttemptedAt < 60_000) return;
    schedulingRetryActive = true;
    schedulingRetryAttemptedAt = Date.now();
    try {
      const data = await requestJson(`${apiBase}/bookings/${encodeURIComponent(bookingId)}/status`, {
        method: "POST",
        headers: { authorization: `Bearer ${manageToken}` },
        body: JSON.stringify({ action: "retry_scheduling", manageToken }),
      });
      const booking = asRecord(data.booking);
      if (Object.keys(booking).length > 0) {
        bookingSnapshot = booking;
        holdExpiresAt = asText(booking.holdExpiresAt) || holdExpiresAt;
        rememberBookingAccess();
        if (asText(booking.status) === "confirmed") showConfirmed(booking);
      }
    } catch {
      // Authoritative polling remains active; retry is throttled above.
    } finally {
      schedulingRetryActive = false;
    }
  };

  const showConfirmed = (booking: UnknownRecord) => {
    window.clearInterval(holdTimer);
    window.clearTimeout(statusPollRetry);
    stopProcessing(false);
    if (bookingHold) bookingHold.hidden = true;
    bookingSnapshot = booking;
    restoreSafeBirthTime(booking);
    currency = asText(booking.currency) || currency;
    renderConfirmation(booking);
    bookingSteps.forEach((panel) => (panel.hidden = true));
    hideStandaloneStates();
    showPaymentAlert(null);
    bookingProgress.forEach((item) => {
      item.toggleAttribute("data-active", Number(item.dataset.bookingProgress) === 4);
    });
    if (bookingConfirmed) bookingConfirmed.hidden = false;
    document.querySelectorAll<HTMLAnchorElement>("[data-booking-account-link]").forEach((accountLink) => {
      const panel = accountLink.dataset.accountPanelLink;
      accountLink.href = panel ? `/account#${panel}` : "/account";
    });
    rememberBookingAccess();
    window.astroPagesTrack?.("booking_confirmed", { status: "confirmed", service: asText(booking.serviceSlug), mode: asText(booking.mode) });
    window.requestAnimationFrame(() => {
      const heading = bookingConfirmed?.querySelector<HTMLElement>("h2");
      heading?.setAttribute("tabindex", "-1");
      heading?.focus({ preventScroll: true });
    });
  };

  const pollBookingStatus = async () => {
    if (statusPollActive) return;
    statusPollActive = true;
    for (let attempt = 0; attempt < 60; attempt += 1) {
      try {
        const data = await statusForBooking();
        const booking = asRecord(data.booking);
        bookingSnapshot = booking;
        restoreSafeBirthTime(booking);
        holdExpiresAt = asText(booking.holdExpiresAt) || holdExpiresAt;
        rememberBookingAccess();
        const status = asText(booking.status);
        if (status === "confirmed") {
          statusPollActive = false;
          showConfirmed(booking);
          return;
        }
        if (status === "expired" || status === "cancelled") {
          statusPollActive = false;
          showExpired();
          return;
        }
        if (status === "payment_action_required" && asText(booking.paymentState) !== "unpaid") {
          startProcessing();
          void retryPaidScheduling();
        }
      } catch {
        // Keep the source processing state while the webhook or network catches up.
      }
      await new Promise((resolve) => window.setTimeout(resolve, 1_500));
    }
    statusPollActive = false;
    statusPollRetry = window.setTimeout(() => void pollBookingStatus(), 15_000);
  };

  bookingForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!bookingId || !manageToken || payNowCents <= 0) {
      if (payNowCents <= 0) {
        startProcessing();
        void pollBookingStatus();
      }
      return;
    }
    startProcessing();
    showPaymentAlert(null);
    window.astroPagesTrack?.("payment_started", { step: 3, service: selectedService(), mode: selectedMode() });
    try {
      const data = await requestJson(`${apiBase}/bookings/${encodeURIComponent(bookingId)}/payment-intent`, {
        method: "POST",
        body: JSON.stringify({ manageToken, kind: selectedPaymentOption() }),
      });
      const payment = asRecord(data.payment);
      holdExpiresAt = asText(payment.holdExpiresAt) || holdExpiresAt;
      rememberBookingAccess();
      try {
        await mountStripeCard(asText(payment.publishableKey));
      } catch {
        stopProcessing(true);
        if (stripeFallback) stripeFallback.hidden = false;
        return;
      }
      if (!stripeClient || !cardElement || !asText(payment.clientSecret)) {
        stopProcessing(true);
        return;
      }
      const result = await stripeClient.confirmCardPayment(asText(payment.clientSecret), {
        payment_method: { card: cardElement },
      });
      if (result.error) {
        const definitiveDecline = result.error.type === "card_error" && Boolean(
          result.error.decline_code || result.error.code === "card_declined",
        );
        if (definitiveDecline) {
          stopProcessing(true);
          showPaymentAlert("declined");
          window.astroPagesTrack?.("payment_failed", {
            status: "declined",
            service: selectedService(),
            mode: selectedMode(),
            step: 3,
          });
        } else if (result.error.type === "validation_error") {
          stopProcessing(true);
        } else {
          await pollBookingStatus();
        }
        return;
      }
      await pollBookingStatus();
    } catch (error) {
      if (error instanceof RequestFailure && error.status >= 400 && error.status < 500) {
        stopProcessing(true);
        if (error.status === 409) showPaymentAlert("slot-taken");
        return;
      }
      // A lost response or provider error can race a successfully-created intent
      // or webhook. Keep the source state and ask for the authoritative outcome.
      await pollBookingStatus();
    }
  });

  const releaseBookingHold = async () => {
    const clearLocalAccess = () => {
      bookingId = "";
      manageToken = "";
      holdExpiresAt = "";
      bookingSnapshot = {};
      currentQuote = {};
      customerName = "";
      customerEmail = "";
      customerTimezone = "";
      birthTimeWasUnknown = false;
      if (bookingHold) bookingHold.hidden = true;
      forgetBookingAccess();
      window.clearInterval(holdTimer);
    };
    if (!bookingId || !manageToken) {
      clearLocalAccess();
      return true;
    }
    if (["expired", "cancelled"].includes(asText(bookingSnapshot.status))) {
      clearLocalAccess();
      return true;
    }
    if (asText(bookingSnapshot.paymentState) !== "unpaid") return false;
    try {
      const data = await requestJson(`${apiBase}/bookings/${encodeURIComponent(bookingId)}/cancel`, {
        method: "POST",
        body: JSON.stringify({ manageToken, reason: "" }),
      });
      if (!["hold_released", "cancelled"].includes(asText(data.cancellationState))) return false;
      clearLocalAccess();
      return true;
    } catch {
      return false;
    }
  };

  document.querySelector<HTMLButtonElement>("[data-booking-back='1']")?.addEventListener("click", () => showBookingStep(1));
  document.querySelector<HTMLButtonElement>("[data-booking-back='2']")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    if (await releaseBookingHold()) showBookingStep(2);
    else button.disabled = false;
  });
  continueToDetails?.addEventListener("click", () => {
    if (selectedStartAt) showBookingStep(2);
  });
  continueToPayment?.addEventListener("click", () => void createBookingHold());

  const showWaitlist = () => {
    bookingSteps.forEach((panel) => (panel.hidden = true));
    if (bookingConfirmed) bookingConfirmed.hidden = true;
    if (expiredState) expiredState.hidden = true;
    if (waitlistState) waitlistState.hidden = false;
    const name = input("waitlist-name");
    const email = input("waitlist-email");
    if (name && !name.value) name.value = input("full-name")?.value || "";
    if (email && !email.value) email.value = input("email")?.value || "";
    const service = selectedService();
    if (service) {
      const waitService = bookingForm?.querySelector<HTMLInputElement>(`input[name="waitlist-service"][value="${service}"]`);
      if (waitService) waitService.checked = true;
    }
    window.requestAnimationFrame(() => name?.focus({ preventScroll: true }));
  };
  waitlistOpenButtons.forEach((button) => button.addEventListener("click", showWaitlist));
  document.querySelector<HTMLButtonElement>("[data-booking-close-waitlist]")?.addEventListener("click", () => showBookingStep(1));

  document.querySelector<HTMLButtonElement>("[data-booking-submit-waitlist]")?.addEventListener("click", async () => {
    const nameField = input("waitlist-name");
    const name = nameField?.value || "";
    const email = input("waitlist-email")?.value || "";
    const service = selectedInput("waitlist-service")?.value || selectedService();
    const error = document.querySelector<HTMLElement>("[data-booking-waitlist-error]");
    const emailField = input("waitlist-email");
    if (!emailField?.checkValidity() || !email.trim()) {
      if (error) error.hidden = false;
      emailField?.focus();
      return;
    }
    if (error) error.hidden = true;
    if (name.trim().length < 2) {
      nameField?.setAttribute("aria-invalid", "true");
      nameField?.focus();
      return;
    }
    nameField?.removeAttribute("aria-invalid");
    if (!service) {
      bookingForm?.querySelector<HTMLInputElement>("input[name='waitlist-service']")?.focus();
      return;
    }
    try {
      const data = await requestJson(`${apiBase}/waitlist`, {
        method: "POST",
        body: JSON.stringify({
          name,
          email,
          serviceSlug: service,
          mode: selectedMode(),
          shortNotice: input("waitlist-short-notice")?.checked === true,
          consentContact: true,
          consentMarketing: false,
          website: "",
        }),
      });
      if (error) error.hidden = true;
      const form = document.querySelector<HTMLElement>("[data-booking-waitlist-form]");
      const done = document.querySelector<HTMLElement>("[data-booking-waitlist-confirmed]");
      if (form) form.hidden = true;
      if (done) done.hidden = false;
      done?.setAttribute("tabindex", "-1");
      done?.focus({ preventScroll: true });
      const serviceNode = document.querySelector<HTMLElement>("[data-booking-waitlist-service]");
      const emailNode = document.querySelector<HTMLElement>("[data-booking-waitlist-email]");
      const shortNode = document.querySelector<HTMLElement>("[data-booking-waitlist-short]");
      if (serviceNode) serviceNode.textContent = serviceLabel(service);
      if (emailNode) emailNode.textContent = email;
      if (shortNode) shortNode.textContent = input("waitlist-short-notice")?.checked
        ? input("waitlist-short-notice")?.nextElementSibling?.textContent?.trim() || ""
        : "";
      const title = done?.querySelector("h2");
      if (title && asNumber(data.waitPosition) > 0) {
        title.textContent = title.textContent?.replace(/\d+/, String(asNumber(data.waitPosition))) || "";
      }
      const waitStat = waitlistState?.querySelector<HTMLElement>(".vera-stat strong");
      if (waitStat && asNumber(data.activeWaitlistCount) > 0) waitStat.textContent = String(asNumber(data.activeWaitlistCount));
      window.astroPagesTrack?.("waitlist_joined", { service, mode: selectedMode(), status: "submitted" });
    } catch {
      if (error) error.hidden = true;
      document.querySelector<HTMLButtonElement>("[data-booking-submit-waitlist]")?.focus();
    }
  });

  document.querySelector<HTMLButtonElement>("[data-booking-return-times]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    if (await releaseBookingHold()) {
      window.astroPagesTrack?.("scheduling_retry_requested", {
        status: "slot_taken",
        service: selectedService(),
        mode: selectedMode(),
        step: 3,
      });
      showBookingStep(1);
      void loadAvailability();
    } else button.disabled = false;
  });
  document.querySelector<HTMLButtonElement>("[data-booking-new-card]")?.addEventListener("click", () => {
    cardElement?.clear();
    showPaymentAlert(null);
  });
  document.querySelector<HTMLButtonElement>("[data-booking-bank-transfer]")?.addEventListener("click", () => {
    window.location.assign("/contact?topic=booking");
  });
  document.querySelector<HTMLButtonElement>("[data-booking-restart-hold]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    if (await releaseBookingHold()) {
      showBookingStep(1);
      void loadAvailability();
    } else button.disabled = false;
  });
  document.querySelector<HTMLButtonElement>("[data-booking-return-reading]")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    if (await releaseBookingHold()) window.location.assign("/readings");
    else button.disabled = false;
  });

  document.querySelectorAll<HTMLButtonElement>("[data-booking-add-calendar]").forEach((button) => {
    button.addEventListener("click", () => {
      const start = asText(bookingSnapshot.selectedStartAt) || selectedStartAt;
      const end = asText(bookingSnapshot.selectedEndAt) || (start
        ? new Date(new Date(start).getTime() + asNumber(serviceRow(asText(bookingSnapshot.serviceSlug)).durationMinutes) * 60_000).toISOString()
        : "");
      if (!start || !end) return;
      const stamp = (value: string) => new Date(value).toISOString().replace(/[-:]/g, "").replace(/\.\d{3}/, "");
      const summary = serviceLabel(asText(bookingSnapshot.serviceSlug));
      const location = asText(bookingSnapshot.calendlyMeetingUrl) || (asText(bookingSnapshot.mode) === "in_person" ? "Via delle Stelle 12, Trieste" : "");
      const lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//Vera Solaro//Sitting//EN",
        "BEGIN:VEVENT",
        `UID:${bookingId}@vera-solaro`,
        `DTSTAMP:${stamp(new Date().toISOString())}`,
        `DTSTART:${stamp(start)}`,
        `DTEND:${stamp(end)}`,
        `SUMMARY:${summary.replace(/[\\,;]/g, " ")}`,
        ...(location ? [`LOCATION:${location.replace(/[\\,;]/g, " ")}`] : []),
        "END:VEVENT",
        "END:VCALENDAR",
      ];
      const href = URL.createObjectURL(new Blob([lines.join("\r\n")], { type: "text/calendar;charset=utf-8" }));
      const anchor = document.createElement("a");
      anchor.href = href;
      anchor.download = "vera-solaro-sitting.ics";
      anchor.click();
      URL.revokeObjectURL(href);
    });
  });

  const initializeBooking = async () => {
    const preset = new URLSearchParams(window.location.search).get("service");
    if (["natal-hour", "year-ahead", "two-charts"].includes(preset ?? "")) {
      const presetInput = bookingForm?.querySelector<HTMLInputElement>(`input[name="service"][value="${preset}"]`);
      if (presetInput) presetInput.checked = true;
    }
    try {
      catalog = await requestJson(`${apiBase}/catalog`);
      const deposit = asNumber(catalog.depositCents);
      if (deposit > 0) updateSubmitAmount(deposit, "USD");
    } catch {
      catalog = {};
    }
    restoreBookingAccess();
    if (customerName && input("full-name")) input("full-name")!.value = customerName;
    if (customerEmail && input("email")) input("email")!.value = customerEmail;
    syncUnknownBirthTime();
    if (customerTimezone) {
      const timezoneChoice = bookingForm?.querySelector<HTMLInputElement>(
        `input[name="timezone"][value="${CSS.escape(customerTimezone)}"]`,
      );
      if (timezoneChoice) timezoneChoice.checked = true;
    }
    if (bookingId && manageToken) {
      try {
        const data = await statusForBooking();
        bookingSnapshot = asRecord(data.booking);
        restoreSafeBirthTime(bookingSnapshot);
        const status = asText(bookingSnapshot.status);
        const serviceChoice = bookingForm?.querySelector<HTMLInputElement>(
          `input[name="service"][value="${CSS.escape(asText(bookingSnapshot.serviceSlug))}"]`,
        );
        if (serviceChoice) serviceChoice.checked = true;
        const meetingValue = asText(bookingSnapshot.mode) === "in_person" ? "room" : "call";
        const meetingChoice = bookingForm?.querySelector<HTMLInputElement>(
          `input[name="meeting"][value="${meetingValue}"]`,
        );
        if (meetingChoice) meetingChoice.checked = true;
        selectedStartAt = asText(bookingSnapshot.selectedStartAt);
        currency = asText(bookingSnapshot.currency) || "USD";
        holdExpiresAt = asText(bookingSnapshot.holdExpiresAt) || holdExpiresAt;
        rememberBookingAccess();
        if (status === "confirmed") {
          showConfirmed(bookingSnapshot);
          return;
        }
        if (status === "expired" || status === "cancelled") {
          showExpired();
          return;
        }
        const paymentOption = asText(bookingSnapshot.paymentOption) === "full" ? "full" : "deposit";
        authoritativePaymentOption = paymentOption;
        const paymentChoice = bookingForm?.querySelector<HTMLInputElement>(`input[name="payment-amount"][value="${paymentOption}"]`);
        if (paymentChoice) paymentChoice.checked = true;
        payNowCents = paymentOption === "full"
          ? asNumber(bookingSnapshot.balanceCents)
          : Math.min(asNumber(catalog.depositCents) || 8_000, asNumber(bookingSnapshot.balanceCents));
        currentQuote = {
          priceCents: asNumber(bookingSnapshot.priceCents),
          giftAppliedCents: asNumber(bookingSnapshot.giftAppliedCents),
          totalDueCents: Math.max(
            0,
            asNumber(bookingSnapshot.priceCents) - asNumber(bookingSnapshot.giftAppliedCents),
          ),
          payNowCents,
        };
        updateSubmitAmount(payNowCents, currency);
        showBookingStep(3, false);
        if (status === "payment_action_required" || asText(bookingSnapshot.paymentState) !== "unpaid") {
          startProcessing();
          void pollBookingStatus();
          return;
        }
        startHoldTimer();
        void mountStripeCard().catch(() => {
          if (stripeFallback) stripeFallback.hidden = false;
        });
        return;
      } catch (error) {
        if (error instanceof RequestFailure && [401, 403, 404, 410].includes(error.status)) {
          forgetBookingAccess();
          bookingId = "";
          manageToken = "";
        } else {
          startProcessing();
          window.clearTimeout(statusPollRetry);
          statusPollRetry = window.setTimeout(() => void initializeBooking(), 15_000);
          return;
        }
      }
    }
    void loadAvailability();
  };

  void initializeBooking();
</script>
