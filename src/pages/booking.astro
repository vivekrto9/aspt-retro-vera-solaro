---
import { loadPublicPageContent } from "../builder/public-page.ts";
import VeraFrame from "../components/vera/VeraFrame.astro";

export const prerender = false;

const page = await loadPublicPageContent(Astro, "booking");
const { content, builderEdit, chromeEdit } = page;
const services = [1, 2, 3];
const timezones = [1, 2, 3, 4];
const calendarWeekdays = String(content.calendar_weekdays ?? "").split("\n");
const calendarLegendRows = String(content.calendar_legend ?? "").split("\n");
const calendarLegend = calendarLegendRows.slice(0, 3);
const calendarRuntimeCopy = calendarLegendRows.slice(3);
const summaryLabels = String(content.summary_labels ?? "").split("\n");
const unknownTimeCopy = String(content.birth_time_unknown_copy ?? "").split("\n");
const unknownTimeOptions = String(content.birth_time_approx_options ?? "").split("\n");
const unknownTimeValues = ["Small hours", "Morning", "Around midday", "Afternoon", "Evening", "No idea at all"];
const unknownTimeLookup = String(content.birth_time_lookup ?? "").split("\n");
const paymentPolicies = [1, 2].map((index) =>
  String(content[`payment_policy_${index}`] ?? "").split("\n"),
);
const waitStats = String(content.wait_stats ?? "").split("\n").map((row) => {
  const [value = "", label = ""] = row.split("|");
  return { value, label };
});
const confirmationPrep = [1, 2, 3].map((index) =>
  String(content[`confirmed_prep_${index}`] ?? "").split("\n"),
);
const validationErrors = String(content.validation_errors ?? "").split("\n");
const confirmationEmailReply = String(content.confirmed_email_reply ?? "").split("\n");
---

<VeraFrame {...page} currentPath="/booking">
  <section class="vera-page-hero">
    <p class="vera-status-pill" {...builderEdit("booking_eyebrow")}>
      <span aria-hidden="true">✷</span>{content.booking_eyebrow}
    </p>
    <h1 class="vera-display" style="margin-top: 20px" {...builderEdit("booking_title")}>
      {content.booking_title}
    </h1>
    <p class="vera-lede" {...builderEdit("booking_intro")}>{content.booking_intro}</p>
  </section>

  <section class="vera-section vera-section--paper">
    <form class="vera-booking-shell" data-vera-booking novalidate>
      <div class="vera-booking-progress-row">
        <div class="vera-booking-progress" aria-label={content.booking_title}>
          {[1, 2, 3, 4].map((index) => (
            <span data-booking-progress={index} data-active={index === 1 ? "" : undefined}>
              {index} · <i style="font-style: normal" {...builderEdit(`step_${index}_label`)}>
                {content[`step_${index}_label`]}
              </i>
            </span>
          ))}
        </div>
        <p class="vera-booking-hold" data-booking-hold hidden aria-live="off">
          <span {...builderEdit("hold_label")}>{content.hold_label}</span>{" "}
          <strong data-booking-hold-label></strong>
        </p>
      </div>

      <div class="vera-booking-step" data-booking-step="1">
        <fieldset class="vera-form-section">
          <legend {...builderEdit("service_label")}>{content.service_label}</legend>
          <div class="vera-filter-pills">
            {services.map((index) => (
              <label class="vera-pill">
                <input
                  type="radio"
                  name="service"
                  value={index === 1 ? "natal-hour" : index === 2 ? "year-ahead" : "two-charts"}
                />
                <span {...builderEdit(`service_${index}`)}>{content[`service_${index}`]}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="vera-form-section" style="margin-top: 34px">
          <legend {...builderEdit("meeting_label")}>{content.meeting_label}</legend>
          <div class="vera-choice-grid">
            <label class="vera-choice">
              <input type="radio" name="meeting" value="call" checked />
              <strong {...builderEdit("call_title")}>{content.call_title}</strong>
              <span {...builderEdit("call_body")}>{content.call_body}</span>
              <span class="vera-card-meta" {...builderEdit("call_days")}>{content.call_days}</span>
            </label>
            <label class="vera-choice">
              <input type="radio" name="meeting" value="room" />
              <strong {...builderEdit("room_title")}>{content.room_title}</strong>
              <span {...builderEdit("room_body")}>{content.room_body}</span>
              <span class="vera-card-meta" {...builderEdit("room_days")}>{content.room_days}</span>
            </label>
          </div>
        </fieldset>

        <fieldset class="vera-form-section" style="margin-top: 34px">
          <legend class="vera-visually-hidden" {...builderEdit("calendar_label")}>{content.calendar_label}</legend>
          <div class="vera-calendar-toolbar">
            <div class="vera-calendar-month-control">
              <button type="button" data-calendly-prev-month aria-label={content.calendar_month}>←</button>
              <strong data-calendly-month-label {...builderEdit("calendar_month")}>{content.calendar_month}</strong>
              <button type="button" data-calendly-next-month aria-label={content.calendar_month}>→</button>
            </div>
            <div class="vera-calendar-timezones">
              <span class="vera-label" {...builderEdit("timezone_label")}>{content.timezone_label}</span>
              <div class="vera-filter-pills">
                {timezones.map((index) => (
                  <label class="vera-pill">
                    <input
                      type="radio"
                      name="timezone"
                      value={index === 1 ? "Europe/Rome" : index === 2 ? "Europe/London" : index === 3 ? "America/New_York" : "America/Los_Angeles"}
                      checked={index === 1}
                    />
                    <span {...builderEdit(`timezone_${index}`)}>{content[`timezone_${index}`]}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>
          <div class="vera-calendar-weekdays" {...builderEdit("calendar_weekdays")}>
            {calendarWeekdays.map((weekday) => <span>{weekday}</span>)}
          </div>
          <div
            class="vera-calendar-month"
            aria-label={content.calendar_label}
            data-calendly-month-grid
            data-slot-singular={calendarRuntimeCopy[0]}
            data-slot-plural={calendarRuntimeCopy[1]}
            data-hour-singular={calendarRuntimeCopy[2]}
            data-hour-plural={calendarRuntimeCopy[3]}
            data-time-suffix={calendarRuntimeCopy[4]}
            data-no-sittings={calendarLegend[2]}
          ></div>
          <div class="vera-calendar-legend" {...builderEdit("calendar_legend")}>
            {calendarLegend.map((label, index) => (
              <span><i data-kind={index === 0 ? "open" : index === 1 ? "chosen" : "closed"}></i>{label}</span>
            ))}
          </div>
          <div
            class="vera-info-card"
            style="margin-top: 40px"
            data-calendly-slot-mount
            data-empty-copy={content.calendar_empty}
            data-error-copy={content.calendar_error}
            aria-live="polite"
          >
            <p data-calendly-status {...builderEdit("calendar_loading")}>{content.calendar_loading}</p>
            <div data-calendly-day-hours hidden>
              <div class="vera-calendar-day-heading">
                <strong data-calendly-day-label></strong>
                <span data-calendly-day-count></span>
              </div>
              <div class="vera-calendar-slots" data-calendly-live-slots></div>
              <p class="vera-form-note vera-calendar-local-note" {...builderEdit("calendar_local_note")}>{content.calendar_local_note}</p>
            </div>
            <p data-calendly-prompt {...builderEdit("calendar_prompt")}>{content.calendar_prompt}</p>
            <span class="vera-visually-hidden" {...builderEdit("calendar_empty")}>{content.calendar_empty}</span>
            <span class="vera-visually-hidden" {...builderEdit("calendar_error")}>{content.calendar_error}</span>
            <button class="vera-button vera-button--burnt vera-button--small" style="margin-top: 14px" type="button" data-booking-open-waitlist hidden {...builderEdit("wait_submit_cta")}>
              {content.wait_submit_cta}
            </button>
          </div>
        </fieldset>

        <div class="vera-actions">
          <button
            class="vera-button vera-button--burnt vera-button--shadow"
            type="button"
            data-booking-next="2"
            disabled
            {...builderEdit("continue_details_cta")}
          >
            {content.continue_details_cta}
          </button>
        </div>
      </div>

      <div class="vera-booking-step" data-booking-step="2" hidden>
        <h2 class="vera-heading" {...builderEdit("details_title")}>{content.details_title}</h2>
        <p class="vera-lede" {...builderEdit("details_intro")}>{content.details_intro}</p>

        <fieldset class="vera-form-card" style="margin-top: 30px">
          <legend {...builderEdit("sitter_legend")}>{content.sitter_legend}</legend>
          <div class="vera-field-row">
            <label class="vera-field">
              <span class="vera-label" {...builderEdit("name_label")}>{content.name_label}</span>
              <input
                class="vera-input"
                name="full-name"
                autocomplete="name"
                required
                placeholder={content.name_placeholder}
                {...builderEdit("name_placeholder")}
              />
              <p class="vera-form-note" data-booking-intake-error="name" hidden aria-live="polite" {...builderEdit("validation_errors")}>{validationErrors[0]}</p>
            </label>
            <label class="vera-field">
              <span class="vera-label" {...builderEdit("email_label")}>{content.email_label}</span>
              <input
                class="vera-input"
                name="email"
                type="email"
                autocomplete="email"
                required
                placeholder={content.email_placeholder}
                {...builderEdit("email_placeholder")}
              />
              <p class="vera-form-note" data-booking-intake-error="email" hidden aria-live="polite" {...builderEdit("validation_errors")}>{validationErrors[1]}</p>
            </label>
          </div>
        </fieldset>

        <fieldset class="vera-form-card" style="margin-top: 24px">
          <legend {...builderEdit("birth_legend")}>{content.birth_legend}</legend>
          <div class="vera-field-row">
            <label class="vera-field">
              <span class="vera-label" {...builderEdit("birth_date_label")}>{content.birth_date_label}</span>
              <input
                class="vera-input"
                name="birth-date"
                required
                placeholder={content.birth_date_placeholder}
                {...builderEdit("birth_date_placeholder")}
              />
              <p class="vera-form-note" data-booking-intake-error="birth-date" hidden aria-live="polite" {...builderEdit("validation_errors")}>{validationErrors[2]}</p>
            </label>
            <label class="vera-field">
              <span class="vera-label" {...builderEdit("birth_time_label")}>{content.birth_time_label}</span>
              <input
                class="vera-input"
                name="birth-time"
                placeholder={content.birth_time_placeholder}
                {...builderEdit("birth_time_placeholder")}
              />
            </label>
          </div>
          <label class="vera-form-note">
            <input type="checkbox" name="birth-time-unknown" />
            <span {...builderEdit("birth_time_unknown")}>{content.birth_time_unknown}</span>
          </label>
          <section class="vera-unknown-time" data-booking-unknown-time hidden>
            <h3 {...builderEdit("birth_time_unknown_copy")}>{unknownTimeCopy[0]}</h3>
            <p {...builderEdit("birth_time_unknown_copy")}>{unknownTimeCopy.slice(1).join("\n")}</p>
            <fieldset data-booking-time-approximation>
              <legend {...builderEdit("birth_time_approx_label")}>{content.birth_time_approx_label}</legend>
              <div class="vera-unknown-time__choices" {...builderEdit("birth_time_approx_options")}>
                {unknownTimeOptions.map((option, index) => (
                  <label class="vera-pill">
                    <input type="radio" name="birth-time-approximation" value={unknownTimeValues[index]} />
                    <span>{option}</span>
                  </label>
                ))}
              </div>
            </fieldset>
            <aside class="vera-unknown-time__lookup" {...builderEdit("birth_time_lookup")}>
              <strong>{unknownTimeLookup[0]}</strong>
              <span>{unknownTimeLookup.slice(1).join("\n")}</span>
            </aside>
          </section>
          <label class="vera-field">
            <span class="vera-label" {...builderEdit("birth_place_label")}>{content.birth_place_label}</span>
            <input
              class="vera-input"
              name="birth-place"
              required
              placeholder={content.birth_place_placeholder}
              {...builderEdit("birth_place_placeholder")}
            />
            <div class="vera-place-suggestions" data-booking-place-suggestions hidden></div>
            <p class="vera-form-note" data-booking-place-error hidden aria-live="polite" {...builderEdit("birth_place_error")}>
              {content.birth_place_error}
            </p>
            <p class="vera-form-note" data-booking-place-resolved hidden aria-live="polite">
              <span aria-hidden="true">✓</span>
              <span data-booking-place-resolved-label></span>
            </p>
          </label>
        </fieldset>

        <fieldset class="vera-form-card" style="margin-top: 24px">
          <legend {...builderEdit("intention_label")}>{content.intention_label}</legend>
          <p class="vera-form-note" {...builderEdit("intention_note")}>{content.intention_note}</p>
          <textarea
            class="vera-textarea"
            name="intention"
            placeholder={content.intention_placeholder}
            {...builderEdit("intention_placeholder")}
          ></textarea>
          <label class="vera-form-note">
            <input type="checkbox" name="consent" required />
            <span {...builderEdit("consent_label")}>{content.consent_label}</span>
          </label>
          <p class="vera-form-note" data-booking-intake-error="consent" hidden aria-live="polite" {...builderEdit("validation_errors")}>{validationErrors[3]}</p>
        </fieldset>

        <div class="vera-actions">
          <button class="vera-button vera-button--paper" type="button" data-booking-back="1" {...builderEdit("back_cta")}>
            {content.back_cta}
          </button>
          <button
            class="vera-button vera-button--burnt vera-button--shadow"
            type="button"
            data-booking-next="3"
            {...builderEdit("continue_payment_cta")}
          >
            {content.continue_payment_cta}
          </button>
        </div>
      </div>

      <div class="vera-booking-step" data-booking-step="3" hidden>
        <div class="vera-booking-payment-grid">
          <div class="vera-booking-payment-main">
            <aside
              class="vera-booking-alert vera-booking-alert--declined"
              data-booking-state="declined"
              hidden
              aria-live="assertive"
            >
              <span class="vera-booking-alert__symbol" aria-hidden="true">!</span>
              <div>
                <h2 {...builderEdit("declined_title")}>{content.declined_title}</h2>
                <p>
                  <span {...builderEdit("declined_body_before")}>{content.declined_body_before}</span>{" "}
                  <strong data-booking-hold-label></strong>
                  <span {...builderEdit("declined_body_after")}>{content.declined_body_after}</span>
                </p>
                <div class="vera-actions">
                  <button class="vera-button vera-button--burnt vera-button--small" type="button" data-booking-new-card {...builderEdit("declined_card_cta")}>
                    {content.declined_card_cta}
                  </button>
                  <button class="vera-button vera-button--paper vera-button--small" type="button" data-booking-bank-transfer {...builderEdit("declined_transfer_cta")}>
                    {content.declined_transfer_cta}
                  </button>
                </div>
              </div>
            </aside>

            <aside
              class="vera-booking-alert vera-booking-alert--taken"
              data-booking-state="slot-taken"
              hidden
              aria-live="assertive"
            >
              <span class="vera-booking-alert__symbol" aria-hidden="true">✷</span>
              <div>
                <h2 {...builderEdit("taken_title")}>{content.taken_title}</h2>
                <p data-booking-taken-copy {...builderEdit("taken_body")}>{content.taken_body}</p>
                <div class="vera-actions">
                  <button class="vera-button vera-button--mustard vera-button--small" type="button" data-booking-return-times {...builderEdit("taken_hours_cta")}>
                    {content.taken_hours_cta}
                  </button>
                  <button class="vera-button vera-button--paper vera-button--small" type="button" data-booking-open-waitlist {...builderEdit("taken_waitlist_cta")}>
                    {content.taken_waitlist_cta}
                  </button>
                </div>
              </div>
            </aside>

            <h2 class="vera-heading" {...builderEdit("payment_title")}>{content.payment_title}</h2>
            <p class="vera-lede" {...builderEdit("payment_intro")}>{content.payment_intro}</p>

            <fieldset class="vera-form-section" style="margin-top: 30px">
              <legend class="vera-visually-hidden">{content.payment_title}</legend>
              <div class="vera-choice-grid">
                <label class="vera-choice">
                  <input type="radio" name="payment-amount" value="deposit" checked />
                  <span class="vera-booking-choice-heading">
                    <strong {...builderEdit("deposit_title")}>{content.deposit_title}</strong>
                    <b data-booking-deposit-amount></b>
                  </span>
                  <span data-booking-deposit-body {...builderEdit("deposit_body")}>{content.deposit_body}</span>
                </label>
                <label class="vera-choice">
                  <input type="radio" name="payment-amount" value="full" />
                  <span class="vera-booking-choice-heading">
                    <strong {...builderEdit("full_title")}>{content.full_title}</strong>
                    <b data-booking-full-amount></b>
                  </span>
                  <span {...builderEdit("full_body")}>{content.full_body}</span>
                </label>
              </div>
            </fieldset>

            <fieldset class="vera-form-card" style="margin-top: 24px">
              <legend {...builderEdit("card_label")}>{content.card_label}</legend>
              <div class="vera-stripe-mount" data-stripe-elements-mount role="group" aria-label={content.card_label}>
                <p class="vera-form-note" data-stripe-fallback {...builderEdit("card_fallback")}>{content.card_fallback}</p>
              </div>
            </fieldset>

            <fieldset class="vera-form-card" style="margin-top: 24px">
              <legend {...builderEdit("gift_label")}>{content.gift_label}</legend>
              <div class="vera-field-row">
                <input
                  class="vera-input"
                  name="gift"
                  placeholder={content.gift_placeholder}
                  {...builderEdit("gift_placeholder")}
                />
                <button class="vera-button vera-button--paper" type="button" data-booking-gift-apply {...builderEdit("gift_cta")}>{content.gift_cta}</button>
              </div>
              <p class="vera-form-note" data-booking-gift-error hidden aria-live="polite" {...builderEdit("gift_error")}>{content.gift_error}</p>
              <p class="vera-form-note" data-booking-gift-applied hidden aria-live="polite">
                <strong data-booking-gift-amount></strong>{" "}
                <span {...builderEdit("gift_applied_suffix")}>{content.gift_applied_suffix}</span>
              </p>
            </fieldset>

            <div class="vera-booking-policies">
              {paymentPolicies.map((parts, index) => (
                <article {...builderEdit(`payment_policy_${index + 1}`)}>
                  <strong>{parts[0]}</strong>
                  <p>{parts.slice(1).join("\n")}</p>
                </article>
              ))}
            </div>

          </div>

          <aside class="vera-booking-payment-summary" data-booking-payment-summary aria-live="polite">
            <div class="vera-card-meta" {...builderEdit("summary_kicker")}>{content.summary_kicker}</div>
            <h3 data-booking-summary-service></h3>
            <p class="vera-booking-payment-summary__duration" data-booking-summary-duration {...builderEdit("summary_duration_suffix")}>{content.summary_duration_suffix}</p>
            <dl class="vera-booking-summary vera-booking-summary--dark">
              <div>
                <dt {...builderEdit("summary_labels")}>{summaryLabels[0]}</dt>
                <dd>
                  <span data-booking-summary-mode="call" hidden {...builderEdit("summary_mode_call")}>{content.summary_mode_call}</span>
                  <span data-booking-summary-mode="in_person" hidden {...builderEdit("summary_mode_room")}>{content.summary_mode_room}</span>
                </dd>
              </div>
              <div>
                <dt {...builderEdit("summary_labels")}>{summaryLabels[1]}</dt>
                <dd><span data-booking-summary-when></span>{" "}<span {...builderEdit("summary_time_suffix")}>{content.summary_time_suffix}</span></dd>
              </div>
              <div>
                <dt {...builderEdit("summary_labels")}>{summaryLabels[2]}</dt>
                <dd><span data-booking-summary-chart></span><span data-booking-summary-unknown hidden {...builderEdit("summary_unknown_suffix")}>{content.summary_unknown_suffix}</span></dd>
              </div>
            </dl>
            <dl class="vera-booking-summary vera-booking-summary--dark vera-booking-payment-summary__money">
              <div>
                <dt {...builderEdit("summary_labels")}>{summaryLabels[3]}</dt>
                <dd data-booking-summary-price></dd>
              </div>
              <div data-booking-summary-gift hidden>
                <dt {...builderEdit("summary_labels")}>{summaryLabels[4]}</dt>
                <dd data-booking-summary-gift-value></dd>
              </div>
              <div class="vera-booking-payment-summary__due">
                <dt {...builderEdit("summary_labels")}>{summaryLabels[5]}</dt>
                <dd data-booking-summary-due></dd>
              </div>
            </dl>
            <p data-booking-summary-balance {...builderEdit("summary_balance_template")}>{content.summary_balance_template}</p>
          </aside>

          <div class="vera-booking-payment-actions">
            <div class="vera-actions">
              <button class="vera-button vera-button--paper" type="button" data-booking-back="2" {...builderEdit("back_cta")}>{content.back_cta}</button>
              <button class="vera-button vera-button--mustard vera-button--shadow" type="submit" {...builderEdit("submit_cta")}>{content.submit_cta}</button>
            </div>
            <p class="vera-form-note" {...builderEdit("secure_note")}>{content.secure_note}</p>
          </div>
        </div>
      </div>

      <section class="vera-booking-confirmed" data-booking-confirmed hidden aria-live="polite">
        <header class="vera-booking-confirmed__header">
          <p class="vera-status-pill">
            <span aria-hidden="true">✓</span>
            <span {...builderEdit("confirmed_kicker")}>{content.confirmed_kicker}</span>{" "}
            <span data-booking-confirmed-reference {...builderEdit("confirmed_reference_template")}>{content.confirmed_reference_template}</span>
          </p>
          <h2 class="vera-display" {...builderEdit("confirmed_title")}>{content.confirmed_title}</h2>
          <p class="vera-lede" data-booking-confirmed-body {...builderEdit("confirmed_body")}>{content.confirmed_body}</p>
        </header>

        <div class="vera-booking-confirmed__grid">
          <div>
            <article class="vera-booking-confirmed__sitting">
              <div>
                <div class="vera-card-meta" {...builderEdit("confirmed_sitting_label")}>{content.confirmed_sitting_label}</div>
                <h3 data-booking-confirmed-service></h3>
                <p><span data-booking-confirmed-when></span>{" "}<span {...builderEdit("summary_time_suffix")}>{content.summary_time_suffix}</span><br /><span data-booking-confirmed-mode></span></p>
              </div>
              <div class="vera-booking-confirmed__paid">
                <div class="vera-card-meta" {...builderEdit("confirmed_paid_label")}>{content.confirmed_paid_label}</div>
                <strong data-booking-confirmed-paid></strong>
                <p data-booking-confirmed-balance {...builderEdit("confirmed_balance_template")}>{content.confirmed_balance_template}</p>
              </div>
              <div class="vera-actions vera-booking-confirmed__actions">
                <button class="vera-button vera-button--mustard vera-button--small" type="button" data-booking-add-calendar {...builderEdit("confirmed_calendar_cta")}>{content.confirmed_calendar_cta}</button>
                <a class="vera-button vera-button--paper vera-button--small" href="/account#reschedule" data-booking-account-link data-account-panel-link="reschedule" {...builderEdit("confirmed_move_cta")}>{content.confirmed_move_cta}</a>
                <a class="vera-button vera-button--paper vera-button--small" href="/account#receipt" data-booking-account-link data-account-panel-link="receipt" {...builderEdit("confirmed_receipt_cta")}>{content.confirmed_receipt_cta}</a>
              </div>
            </article>

            <section class="vera-booking-confirmed__prep">
