---
import { loadPublicPageContent } from "../../builder/public-page.ts";
import VeraFrame from "../../components/vera/VeraFrame.astro";
import VeraImage from "../../components/vera/VeraImage.astro";
import generatedSettings from "../../generated/site-settings.json";
import {
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
} from "../../server/generated-site/seo.ts";

export const prerender = false;

const page = await loadPublicPageContent(Astro, "article_saturn");
const { content, builderEdit } = page;
const jsonLd = [
  buildBreadcrumbJsonLd({
    requestUrl: Astro.request.url,
    items: [
      { name: content.back_label.replace(/^←\s*/, ""), path: "/writing" },
      { name: content.article_title, path: "/writing/saturn-is-not-punishing-you" },
    ],
  }),
  buildArticleJsonLd({
    requestUrl: Astro.request.url,
    siteSettings: generatedSettings.siteSettings,
    headline: content.article_title,
    description: content.article_dek,
    authorName: content.author_name,
    datePublished: "2024-03-12",
    dateModified: "2024-03-12",
    url: "/writing/saturn-is-not-punishing-you",
  }),
].filter(Boolean) as Array<Record<string, unknown>>;
---

<VeraFrame {...page} currentPath="/writing/saturn-is-not-punishing-you" jsonLd={jsonLd}>
  <article>
    <header class="vera-page-hero">
      <a class="vera-card-meta" href="/writing" style="color: var(--vera-burnt); text-decoration: none" {...builderEdit("back_label")}>
        {content.back_label}
      </a>
      <div class="vera-article-header__inner">
        <p class="vera-eyebrow" {...builderEdit("article_meta")}>{content.article_meta}</p>
        <h1 class="vera-display" style="color: var(--vera-burnt); text-shadow: 3px 3px 0 var(--vera-mustard); margin-top: 18px" {...builderEdit("article_title")}>
          {content.article_title}
        </h1>
        <p class="vera-lede" style="font-size: 21px; font-style: italic" {...builderEdit("article_dek")}>
          {content.article_dek}
        </p>
        <div style="display: flex; align-items: center; gap: 14px; margin-top: 26px">
          <VeraImage
            alt={content.article_author_alt}
            altField="article_author_alt"
            edit={builderEdit}
            shape="circle"
            class="vera-article-avatar"
          />
          <div class="vera-card-meta">
            <span {...builderEdit("article_byline")}>{content.article_byline}</span><br />
            <span style="color: var(--vera-burnt)" {...builderEdit("article_place_date")}>
              {content.article_place_date}
            </span>
          </div>
        </div>
      </div>
    </header>

    <div class="vera-section vera-section--paper vera-page-grid">
      <div class="vera-prose">
        <p class="vera-prose__lead" {...builderEdit("paragraph_1")}>{content.paragraph_1}</p>
        <p {...builderEdit("paragraph_2")}>{content.paragraph_2}</p>
        <p {...builderEdit("paragraph_3")}>{content.paragraph_3}</p>

        <h2 id="old-texts" {...builderEdit("section_1_title")}>{content.section_1_title}</h2>
        <p {...builderEdit("section_1_paragraph_1")}>{content.section_1_paragraph_1}</p>
        <p {...builderEdit("section_1_paragraph_2")}>{content.section_1_paragraph_2}</p>
        <blockquote class="vera-pullquote" {...builderEdit("pull_quote")}>
          {content.pull_quote}
        </blockquote>

        <h2 id="punishment-story" {...builderEdit("section_2_title")}>{content.section_2_title}</h2>
        <p {...builderEdit("section_2_paragraph_1")}>{content.section_2_paragraph_1}</p>
        <p {...builderEdit("section_2_paragraph_2")}>{content.section_2_paragraph_2}</p>
        <figure style="margin: 30px 0 0">
          <VeraImage
            alt={content.figure_alt}
            altField="figure_alt"
            edit={builderEdit}
            class="vera-article-figure"
          />
          <figcaption class="vera-card-meta" style="margin-top: 10px" {...builderEdit("figure_caption")}>
            {content.figure_caption}
          </figcaption>
        </figure>

        <h2 id="better-questions" {...builderEdit("section_3_title")}>{content.section_3_title}</h2>
        <p {...builderEdit("section_3_intro")}>{content.section_3_intro}</p>
        <ol class="vera-numbered-list">
          {[1, 2, 3].map((index) => (
            <li>
              <strong>{index}</strong>
              <span {...builderEdit(`question_${index}`)}>{content[`question_${index}`]}</span>
            </li>
          ))}
        </ol>
        <p {...builderEdit("section_3_outro")}>{content.section_3_outro}</p>

        <h2 id="what-happened" {...builderEdit("section_4_title")}>{content.section_4_title}</h2>
        <p {...builderEdit("section_4_paragraph_1")}>{content.section_4_paragraph_1}</p>
        <p {...builderEdit("section_4_paragraph_2")}>{content.section_4_paragraph_2}</p>

        <aside class="vera-info-card vera-article-bio">
          <VeraImage
            alt={content.author_alt}
            altField="author_alt"
            edit={builderEdit}
            shape="circle"
          />
          <div>
            <h2 {...builderEdit("author_name")}>{content.author_name}</h2>
            <p {...builderEdit("author_bio")}>{content.author_bio}</p>
          </div>
        </aside>
      </div>

      <aside class="vera-sidebar">
        <nav class="vera-sidebar-card vera-article-contents" aria-label={content.rail_title}>
          <div class="vera-card-meta" {...builderEdit("rail_title")}>{content.rail_title}</div>
          <a href="#old-texts" aria-current="location" {...builderEdit("rail_1")}>{content.rail_1}</a>
          <a href="#punishment-story" {...builderEdit("rail_2")}>{content.rail_2}</a>
          <a href="#better-questions" {...builderEdit("rail_3")}>{content.rail_3}</a>
          <a href="#what-happened" {...builderEdit("rail_4")}>{content.rail_4}</a>
        </nav>
        <div class="vera-sidebar-card vera-sidebar-card--dark">
          <h2 {...builderEdit("cta_title")}>{content.cta_title}</h2>
          <p {...builderEdit("cta_body")}>{content.cta_body}</p>
          <a class="vera-button vera-button--mustard vera-button--small" style="width: 100%; margin-top: 18px" href="/readings/year-ahead" {...builderEdit("cta_label")}>
            {content.cta_label}
          </a>
        </div>
        <nav class="vera-sidebar-card vera-article-next" aria-label={content.read_next_title}>
          <div class="vera-card-meta" {...builderEdit("read_next_title")}>{content.read_next_title}</div>
          <a href="/writing" {...builderEdit("read_next_1")}>{content.read_next_1}</a>
          <a href="/writing" {...builderEdit("read_next_2")}>{content.read_next_2}</a>
        </nav>
      </aside>
    </div>
  </article>
</VeraFrame>
