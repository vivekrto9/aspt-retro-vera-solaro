---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPublicPageContent } from "../builder/public-page.ts";

export const prerender = false;

const {
  content,
  builder,
  builderPage,
  chromePage,
  reviewTargets,
  builderEdit,
  chromeEdit,
} = await loadPublicPageContent(Astro, "home");
const seoContent = {
  seo_title: content.seo_title,
  seo_description: content.seo_description,
  seo_canonical_path: content.seo_canonical_path,
  seo_robots: content.seo_robots,
  og_title: content.og_title,
  og_description: content.og_description,
  og_image: content.og_image,
  og_image_alt: content.og_image_alt,
  twitter_card: content.twitter_card,
  twitter_title: content.twitter_title,
  twitter_description: content.twitter_description,
  twitter_image: content.twitter_image,
};
---

<BaseLayout
  seo={seoContent}
  builderToolbar={{
    launcherEnabled: builder.launcherEnabled,
    studioModeEnabled: builder.studioModeEnabled,
    collection: builder.collection,
    entry: builder.entry,
    locale: builder.locale,
    csrfToken: builder.csrfToken,
    canPublish: builder.canPublish,
    seo: seoContent,
    hasSavedDraft: builderPage.hasSavedDraft || chromePage.hasSavedDraft,
    reviewTargets,
  }}
>
  <header class="site-header">
    <a class="brand" href="/" aria-label={content.brand_name}>
  <img class="brand-logo" src="/_assets/aliases/logo/logo.svg" alt="" onerror="this.style.display='none'; if (this.nextElementSibling) this.nextElementSibling.style.display='inline-block';" />
  <span class="brand-fallback" style="display:none;" {...chromeEdit("brand_name")}>{content.brand_name}</span>
</a>
    <nav aria-label="Primary">
      <a href="/" {...chromeEdit("nav_home")}>{content.nav_home}</a>
      <a href="/lead-generation-demo">Lead demo</a>
      <a href="/login">Login</a>
      <a href="/signup">Sign up</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="eyebrow" {...builderEdit("hero_kicker")}>{content.hero_kicker}</p>
      <h1 {...builderEdit("hero_title")}>{content.hero_title}</h1>
      <p class="lead" {...builderEdit("hero_body")}>{content.hero_body}</p>
      <div class="actions">
        <a class="button primary" href="/_emdash/admin" {...builderEdit("hero_primary_cta")}>{content.hero_primary_cta}</a>
        <a class="button secondary" href="/api/astropages/generated-site/health" {...builderEdit("hero_secondary_cta")}>{content.hero_secondary_cta}</a>
      </div>
    </section>

    <section class="features" aria-label="Template features">
      {[1, 2, 3].map((index) => (
        <article>
          <h2 {...builderEdit(`feature_${index}_title`)}>{content[`feature_${index}_title`]}</h2>
          <p {...builderEdit(`feature_${index}_body`)}>{content[`feature_${index}_body`]}</p>
        </article>
      ))}
    </section>
  </main>

  <footer class="site-footer">
    <strong {...chromeEdit("footer_brand_name")}>{content.footer_brand_name}</strong>
    <p {...chromeEdit("footer_about")}>{content.footer_about}</p>
    <p {...builderEdit("footer_note")}>{content.footer_note}</p>
  </footer>
</BaseLayout>
