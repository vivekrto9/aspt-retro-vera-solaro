---
import { isOfferedReading } from "../data/vera/offered-readings.ts";
import { getBlogLocale, listBlogPosts } from "../data/blog-posts.ts";
import { loadPublicPageContent } from "../builder/public-page.ts";
import VeraFrame from "../components/vera/VeraFrame.astro";
import VeraImage from "../components/vera/VeraImage.astro";
import ZodiacWheel from "../components/vera/ZodiacWheel.astro";

export const prerender = false;

const page = await loadPublicPageContent(Astro, "home");
const { content, builderEdit, chromeEdit } = page;

const readings = [1, 2, 3].filter(isOfferedReading);
const testimonials = [1, 2, 3];
const locale = getBlogLocale(Astro.request.url);
const { posts } = await listBlogPosts(locale);
const journalFallbackImages = [
  "/_assets/aliases/ephemeris-pages/ephemeris-pages.webp",
  "/_assets/aliases/brass-protractor/brass-protractor.webp",
  "/_assets/aliases/night-sky/night-sky.webp",
];
const journal = posts.slice(0, 3).map((post, index) => ({
  ...post,
  src: post.image?.src || journalFallbackImages[index % journalFallbackImages.length],
  imageAlt: post.image?.alt || post.title,
}));
---

<VeraFrame {...page} currentPath="/">
  <section class="vera-hero">
    <div class="vera-hero__grid">
      <div>
        <p class="vera-hero__badge" {...builderEdit("hero_kicker")}>
          <span aria-hidden="true">★</span>{content.hero_kicker}
        </p>
        <h1 {...builderEdit("hero_title")}>{content.hero_title}</h1>
        <p class="vera-hero__body" {...builderEdit("hero_body")}>{content.hero_body}</p>
        <div class="vera-actions">
          <a
            class="vera-button vera-button--burnt vera-button--shadow"
            href="/booking"
            {...builderEdit("hero_primary_cta")}
          >
            {content.hero_primary_cta}
          </a>
          <a
            class="vera-button vera-button--paper"
            href="/about"
            {...builderEdit("hero_secondary_cta")}
          >
            {content.hero_secondary_cta}
          </a>
        </div>
        <div class="vera-stats">
          {[1, 2, 3].map((index) => (
            <div class="vera-stat">
              <strong {...builderEdit(`hero_stat_${index}_value`)}>
                {content[`hero_stat_${index}_value`]}
              </strong>
              <span {...builderEdit(`hero_stat_${index}_label`)}>
                {content[`hero_stat_${index}_label`]}
              </span>
            </div>
          ))}
        </div>
      </div>
      <ZodiacWheel content={content} edit={builderEdit} />
    </div>
  </section>

  <div class="vera-ticker" aria-label={content.ticker_1}>
    {[1, 2, 3, 4].map((index) => (
      <>
        {index > 1 ? <i aria-hidden="true">✷</i> : null}
        <span {...builderEdit(`ticker_${index}`)}>{content[`ticker_${index}`]}</span>
      </>
    ))}
  </div>

  <section class="vera-section vera-section--sand vera-about-home" id="about">
    <div class="vera-portrait-shell">
      <VeraImage
        src="/_assets/aliases/vera-portrait/vera-portrait.webp"
        alt={content.portrait_alt}
        altField="portrait_alt"
        edit={builderEdit}
        eager
      />
    </div>
    <div>
      <p class="vera-eyebrow" {...builderEdit("about_eyebrow")}>{content.about_eyebrow}</p>
      <h2 class="vera-heading" {...builderEdit("about_title")}>{content.about_title}</h2>
      <p {...builderEdit("about_body_1")}>{content.about_body_1}</p>
      <p {...builderEdit("about_body_2")}>{content.about_body_2}</p>
      <div class="vera-method-pills">
        {[1, 2, 3].map((index) => (
          <span class="vera-pill" {...builderEdit(`about_method_${index}`)}>
            {content[`about_method_${index}`]}
          </span>
        ))}
      </div>
      <div class="vera-signature" {...builderEdit("about_signature")}>
        {content.about_signature}
      </div>
    </div>
  </section>

  <section class="vera-section vera-section--paper" id="readings">
    <header class="vera-section-header">
      <div>
        <p class="vera-eyebrow" {...builderEdit("readings_eyebrow")}>
          {content.readings_eyebrow}
        </p>
        <h2 class="vera-heading" {...builderEdit("readings_title")}>
          {content.readings_title}
        </h2>
      </div>
      <p {...builderEdit("readings_intro")}>{content.readings_intro}</p>
    </header>
    <div class="vera-card-grid">
      {readings.map((index) => (
        <article class:list={["vera-reading-card", index === 2 && "vera-reading-card--featured"]}>
          {index === 2 ? (
            <span class="vera-card-badge" {...builderEdit("reading_2_badge")}>
              {content.reading_2_badge}
            </span>
          ) : null}
          <span class="vera-reading-card__symbol" aria-hidden="true">
            {content[`reading_${index}_symbol`]}
          </span>
          <h3 {...builderEdit(`reading_${index}_title`)}>{content[`reading_${index}_title`]}</h3>
          <div class="vera-card-meta" {...builderEdit(`reading_${index}_meta`)}>
            {content[`reading_${index}_meta`]}
          </div>
          <p {...builderEdit(`reading_${index}_body`)}>{content[`reading_${index}_body`]}</p>
          <ul class="vera-feature-list">
            {[1, 2, 3].map((item) => (
              <li {...builderEdit(`reading_${index}_include_${item}`)}>
                {content[`reading_${index}_include_${item}`]}
              </li>
            ))}
          </ul>
          <footer class="vera-reading-card__footer">
            <span class="vera-price" {...builderEdit(`reading_${index}_price`)}>
              {content[`reading_${index}_price`]}
            </span>
            <a
              class:list={[
                "vera-button",
                "vera-button--small",
                index === 2 ? "vera-button--mustard" : "vera-button--paper",
              ]}
              href={`/readings/${index === 1 ? "natal-hour" : index === 2 ? "year-ahead" : "two-charts"}`}
              {...builderEdit(`reading_${index}_cta`)}
            >
              {content[`reading_${index}_cta`]}
            </a>
          </footer>
        </article>
      ))}
    </div>
  </section>

  <section class="vera-section vera-section--aubergine vera-testimonials-home">
    <header class="vera-section-header">
      <div>
        <p class="vera-eyebrow" {...builderEdit("ledger_eyebrow")}>{content.ledger_eyebrow}</p>
        <h2 class="vera-heading" {...builderEdit("ledger_title")}>{content.ledger_title}</h2>
      </div>
      <p class="vera-card-meta" {...builderEdit("ledger_note")}>{content.ledger_note}</p>
    </header>
    <div class="vera-testimonial-grid">
      {testimonials.map((index) => (
        <figure class="vera-testimonial">
          <div class="vera-testimonial__stars" aria-hidden="true">★★★★★</div>
          <blockquote {...builderEdit(`testimonial_${index}`)}>
            {content[`testimonial_${index}`]}
          </blockquote>
          <figcaption {...builderEdit(`testimonial_${index}_byline`)}>
            {content[`testimonial_${index}_byline`]}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  {journal.length > 0 ? (
    <section class="vera-section vera-section--paper" id="journal">
      <header class="vera-section-header">
        <div>
          <p class="vera-eyebrow" {...builderEdit("journal_eyebrow")}>{content.journal_eyebrow}</p>
          <h2 class="vera-heading" {...builderEdit("journal_title")}>{content.journal_title}</h2>
        </div>
        <a class="vera-button vera-button--paper vera-button--small" href="/writing" {...builderEdit("journal_cta")}>
          {content.journal_cta}
        </a>
      </header>
      <div class="vera-card-grid">
        {journal.map((item) => (
          <a class="vera-journal-card" href={item.href}>
            <VeraImage src={item.src} alt={item.imageAlt} />
            <div class="vera-journal-card__copy">
              <div class="vera-card-meta">{item.meta}</div>
              <h3>{item.title}</h3>
              <p>{item.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  ) : null}

  {/* The monthly letter is not being offered; this signup band is kept out of
      the page until the newsletter is actually run again. */}
  {/*
