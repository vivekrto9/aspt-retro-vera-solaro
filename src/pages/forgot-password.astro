---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = false;

const seoContent = {
  seo_title: "Forgot Password",
  seo_description: "Request a password reset link.",
  seo_canonical_path: "/forgot-password",
  seo_robots: "index,follow",
  og_title: "Forgot Password",
  og_description: "Request a password reset link.",
  twitter_title: "Forgot Password",
  twitter_description: "Request a password reset link.",
};
---

<BaseLayout seo={seoContent} bodyClass="auth-body">
  <main class="auth-page" aria-labelledby="forgot-password-title">
    <section class="auth-copy">
      <a class="brand" href="/">Base Template</a>
      <p class="eyebrow">Password Help</p>
      <h1 id="forgot-password-title">Reset password</h1>
      <p class="lead">Enter your account email to generate a password reset link.</p>
    </section>

    <section class="auth-panel" aria-label="Forgot password form">
      <h2>Forgot password</h2>
      <form class="auth-form" data-password-reset-request-form>
        <label>
          Email
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <button type="submit">Send reset link</button>
        <p class="auth-form__status" data-auth-status></p>
      </form>
      <p class="auth-page__switch">Remembered your password? <a href="/login">Login</a></p>
    </section>
  </main>

  <script>
    document.querySelector("[data-password-reset-request-form]")?.addEventListener("submit", (event) => {
      event.preventDefault();
      const form = event.currentTarget;
      if (!(form instanceof HTMLFormElement)) return;
      const status = document.querySelector("[data-auth-status]");
      const formData = new FormData(form);
      if (status instanceof HTMLElement) status.textContent = "Preparing reset link...";
      fetch("/api/astropages/generated-site/customer-auth/request-password-reset", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email: formData.get("email") }),
      })
        .then(async (response) => {
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(payload.message || "Password reset request failed.");
          const resetUrl = payload.data?.resetUrl ? ` Reset link: ${payload.data.resetUrl}` : "";
          if (status instanceof HTMLElement) status.textContent = `${payload.message || "If the account exists, reset instructions are available shortly."}${resetUrl}`;
        })
        .catch((error) => {
          if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : "Password reset request failed.";
        });
    });
  </script>
</BaseLayout>
